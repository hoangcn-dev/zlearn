@{
    ViewBag.Title = "Tạo mới";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
    ViewBag.ShowLeftOptions = false;
    
    ViewBag.Breadcrumbs = new List<(string Text, string Url)>
    {
        ("Trang chủ", "/"),
        ("Đề đã tạo", "/de-trac-nghiem/de-da-tao"),
        ("Tạo đề mới", "")
    };
}

<div id="update">
    <!-- Top action -->
    <div class="d-flex mb-3">
        <button class="btn bg-white me-2 border highlight-hover" onclick="window.history.back()"><i class="fa-solid fa-arrow-left"></i> Quay lại danh sách</button>
    </div>

    <!-- Features -->
    <div class="d-flex justify-content-center mb-3">
        <button class="btn bg-white me-2 border highlight-hover" onclick="$('#ai-create-dialog').show()"><i class="fa-solid fa-wand-magic-sparkles" style="color: var(--secondary-color)"></i> Tạo câu hỏi nhanh với AI</button>
    </div>

    <!-- Update content -->
    <div class="row g-3">
        <div class="col-2 fw-light" style="min-height: 30px;">Tên</div>
        <div class="col-10"><input name="quizName" type="text" class="form-control" placeholder="Tên đề"></div>

        <div class="col-2 fw-light" style="min-height: 30px;">Nhãn</div>
        <div class="col-10">
            <div class="d-flex">
                <input name="slug" type="text" class="form-control" placeholder="Nhãn rút gọn">
                <button class="btn btn-sm bg-white border highlight-hover fw-light ms-2 flex-nowrap text-nowrap">
                    <i class="fa-solid fa-arrows-rotate"></i> Tạo nhãn từ tên</button>
            </div>
        </div>

        <div class="col-2 fw-light" style="min-height: 30px;">Danh mục</div>
        <div class="col-10">
            <select id="category" class="form-select w-auto">
            </select>
        </div>

        <!-- Is Public -->
        <div class="col-2 fw-light" style="min-height: 30px;">Riêng tư</div>
        <div class="col-10 d-inline-flex flex-wrap">
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="IsPublic" value="public" checked>
                <label class="form-check-label">Công khai</label>
            </div>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="IsPublic" value="private">
                <label class="form-check-label">Cá nhân</label>
            </div>
        </div>

        <div class="col-2 fw-light" style="min-height: 30px;">Tags</div>
        <div class="col-10">
            <div class="d-flex mb-2">
                <div id="tags" class="d-flex flex-row"></div>
                <button class="btn btn-sm bg-white border highlight-hover fw-light" onclick="showAddTagDialog()"><i class="fa-solid fa-plus"></i> Thêm tag</button>
            </div>
        </div>

        <div class="col-2 fw-light" style="min-height: 30px;">Câu hỏi</div>
        <div class="col-10">
            <div class="card card-body px-3 py-2 d-flex flex-row mb-2 shadow-sm align-items-center position-sticky" style="top: 20px; z-index: 1;">
                <div id="questionCount">0 Câu hỏi</div>
                <div class="flex-fill"></div>
                <i class="fa-solid fa-share opacity-hover me-2" title="Dịch tới câu hỏi"></i>
                <i class="fa-solid fa-plus opacity-hover me-2" title="Thêm câu hỏi" onclick="addQuestion()"></i>
                <i class="fa-solid fa-floppy-disk opacity-hover" title="Lưu thay đổi" onclick="create()"></i>
            </div>

            <div id="questions" class="pt-5"></div>
        </div>
    </div>
</div>

<!-- Create new one with AI -->
<div id="ai-create-dialog" class="vh-100 vw-100 position-fixed top-0 start-0 bg-secondary bg-opacity-50" style="z-index: 1;">
    <div class="rounded-1 position-absolute start-50 translate-middle-x bg-white text-dark p-2 px-3" style="margin-top: 50px; width: 600px;">
        <div class="d-flex flex-column align-items-center pb-2">
            <div class="btn-close position-absolute end-0 top-0 m-1 opacity-hover" onclick="$('#ai-create-dialog').hide()"></div>
            <h5 class="text-center my-3">Tạo câu hỏi nhanh với AI</h5>
            <textarea  rows="10" class="form-control mt-3" placeholder="Nhập mô tả nội dung câu hỏi, bao gồm số câu và nội dung (VD: Tạo 10 câu hỏi về môn ngữ văn lớp 12). Nếu đính kèm file nguồn vui lòng ghi thông tin về cách chuyển đổi thành câu hỏi"></textarea>
            <button id="uploadSourceFileBtn" class="border bg-white shadow-sm p-1 px-2 mt-2 highlight-hover me-2 mb-2"><i class="fa-solid fa-arrow-up-from-bracket"></i> (.pdf, .docx, .xlsx)</button>
            <div id="uploadedSourceFiles" class="d-flex mt-2 align-items-center flex-wrap">
            </div>
            <p class="fst-italic text-danger px-3 text-center" style="font-size: 12px;">Quá trình tạo dữ liệu câu hỏi có thể bị lỗi, vui lòng thử lại (nếu thất bại) và kiểm tra kĩ nội dung câu hỏi được tạo ra!</p>
            <div class="d-flex justify-content-center mt-3">
                <button class="btn text-light opacity-hover py-2 px-5 fs-5 fw-light" onclick="generateQuestions()" style="background-color: var(--main-color);">Tạo danh sách câu hỏi</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script asp-append-version="true">
        const tags = [];

        $('#ai-create-dialog').hide();
        $(document).ready(async function () {
            // Get categories
            getData(`/quizzes/categories`, res => {
                res = res.data;
                $('#category').empty();
                $('#category').append(`<option value="">Tất cả danh mục</option>`);
                res.forEach(c => {
                    $('#category').append(`<option value="${c.id}">${c.name}</option>`);
                });
            }, false);

            // Get all tags
            await  getData(`/quizzes/tags`, res => {
                res = res.data;
                res.forEach(t => tags.push(t));
            }, false);

            // Set listener
            $('#uploadSourceFileBtn').on('click', () => uploadAutoGenerateSourceFile("#uploadedSourceFiles", ".pdf, .docx, .xlsx"));
            $('input[name="slug"]').next('button').on('click', () => {
                const quizName = $('input[name="quizName"]').val();
                $('input[name="slug"]').val(generateSlug(quizName));
            });
        });
    </script>

    <script asp-append-version="true">
        let questions = [];
        let autoGenQuestionSourceFile = null;

        function base64ToFile(base64String, fileName, mimeType='application/octet-stream') {
            const base64Data = base64String.split(',')[1] || base64String;
            // Base64 to bytes
            const byteCharacters = atob(base64Data);
            const byteNumbers = new Array(byteCharacters.length);
            for (let i = 0; i < byteCharacters.length; i++) {
                byteNumbers[i] = byteCharacters.charCodeAt(i);
            }
            const byteArray = new Uint8Array(byteNumbers);
            const blob = new Blob([byteArray], { type: mimeType });
            return new File([blob], fileName, { type: mimeType });
        }

        async function create() {
            showConfirm(
                "Xác nhận tạo mới?",
                async () => {
                    var createData = {
                        name: $('input[name="quizName"]').val(),
                        categoryId: $('#category').val(),
                        isPublic: $('input[name="IsPublic"]:checked').val() == 'public',
                        slug: $('input[name="slug"]').val(),
                        tags: $('#tags').find('.tag-name').map(function() { return $(this).text(); }).get(),
                        questions: questions
                    }
                    await saveMediaFile();
                    postJsonData(`/quizzes`, {data: createData}, res => {
                        console.log(res);
                        if (res.succeeded)
                            showMess("Tạo đề thành công!");
                    });
                }
            );
        }

        async function saveMediaFile() {
            const files = [];
            $('.file-name').each(function() {
                const url = $(this).attr('data-url');
                if (url.startsWith('data:')) {
                    const file = base64ToFile(url, $(this).text());
                    files.push(file);
                }
            });

            if (files.length == 0) return Promise.resolve();
            var res = await saveFiles(files);
            const fileDic = {};
            res.data.files.forEach(e => fileDic[e.fileName] = e.sourceUrl);
            questions.forEach(q => {
                for (let i = 0; i < q.mediaFileUrls.length; i++) {
                    const fileId = q.mediaFileUrls[i];
                    if (fileId in fileDic) {
                        q.mediaFileUrls[i] = fileDic[fileId];
                    }
                }
                q.answers.forEach(a => {
                    for (let i = 0; i < a.mediaFileUrls.length; i++) {
                        const fileId = a.mediaFileUrls[i];
                        if (fileId in fileDic) {
                            a.mediaFileUrls[i] = fileDic[fileId];
                        }
                    }
                });
            });

            $('.file-name').each(function() {
                const filename = $(this).text();
                if (filename in fileDic) {
                    $(this).attr('data-url', fileDic[filename]);
                }
            });

            return Promise.resolve();
        }

        function addQuestion(q = {
                stringContent: '',
                mediaFileUrls: [],
                correctKey: 0,
                order: questions.length + 1,
                answers: [
                    { key: 1, stringContent: '', mediaFileUrls: [] },
                    { key: 2, stringContent: '', mediaFileUrls: [] },
                    { key: 3, stringContent: '', mediaFileUrls: [] },
                    { key: 4, stringContent: '', mediaFileUrls: [] }
                ],
                explanation: '',
                isRemoved: false
            }) {
            const qIndex = questions.length;
            questions.push(q);

            const qDiv = $(`
                <div id="${qIndex}" class="d-flex mb-2 flex-column mb-4">
                    <!-- Content -->
                    <div class="d-flex w-100 mb-2">
                        <span class="fw-bold" style="width: 30px;">${qIndex + 1}</span>
                        <textarea class="stringContent form-control" placeholder="Nội dung câu hỏi">${q.stringContent}</textarea>
                    </div>

                    <!-- Question Media -->
                    <div class="d-flex flex-row flex-wrap qFiles" style="margin-left: 30px;"></div>
                    <div class="d-flex mb-2" style="margin-left: 30px;">
                        <button class="addQFile btn btn-sm bg-white me-2 border highlight-hover fw-light"><i class="fa-solid fa-photo-film"></i> Thêm ảnh/video/audio</button>
                    </div>

                    <div class="answers"></div

                    <!-- Select correct ans -->
                    <div class="d-flex w-100 fw-light mb-2" style="padding-left: 30px;">
                        <div class="me-3">Đáp án đúng: </div>
                        <div class="answerKeySelect d-flex flex-row"></div>
                    </div>

                    <div class="d-flex w-100 align-items-center mb-2" style="padding-left: 30px;">
                        <textarea class="form-control explanation" placeholder="Giải thích">${q.explanation || ''}</textarea>
                    </div>
                    <div class="d-flex w-100 justify-content-center">
                        <button class="removeQuestion btn btn-sm bg-white border highlight-hover fw-light me-2"><i class="fa-solid fa-trash text-danger"></i> Xóa câu hỏi</button>
                        <button class="addAnswer btn btn-sm bg-white border highlight-hover fw-light"><i class="fa-solid fa-plus"></i> Thêm câu trả lời</button>
                    </div>
                </div>
            `);
            qDiv.find('.stringContent').on('change', function() {
                q.stringContent = $(this).val();
            });
            qDiv.find('.explanation').on('change', function() {
                q.explanation = $(this).val();
            });
            $('#questions').on('change', `input[name="${qIndex}_correctKey"]`, function() {
                q.correctKey = $(this).val();
            });


            // Action
            qDiv.find('button.removeQuestion').click(() => {
                qDiv.html(`
                    <div class="fst-italic text-center fw-light">Đã xóa câu ${q.order}</div>
                `);
                q.isRemoved = true;
                $('#questionCount').text(`${questions.filter(e => !e.isRemoved).length} Câu hỏi`);
            });

            // Question media
            q.mediaFileUrls.forEach(e => qDiv.find('.qFiles').append(getFileTag(getFileName(e), e)));
            qDiv.find('button.addQFile').click(() => addMediaFile(`#${qIndex} .qFiles`, "image/*,video/*,audio/*", qIndex, -1));

            

            const container = $('#questions');
            if (questions.length > 1) container.append(`<hr class="my-5">`);
            container.append(qDiv);

            // Answers
            q.answers.forEach((e, i) => addAnswer(qIndex, i, e));
            qDiv.find('button.addAnswer').click(() => {
                const aIndex = questions[qIndex].answers.length;
                const a = { key: aIndex+1, stringContent: '', mediaFileUrls: [] };
                questions[qIndex].answers.push(a);
                addAnswer(qIndex, aIndex, a);
            });

            $('#questionCount').text(`${questions.filter(e => !e.isRemoved).length} Câu hỏi`);
        }

        function addAnswer(qIndex, aIndex, a) {
            a.key = aIndex + 1;
            const aTag = `${String.fromCharCode('A'.charCodeAt(0) + aIndex)}`;
            const answer = $(`
                <div class="${aIndex} d-flex flex-column">
                    <div class="d-flex w-100 align-items-center mb-2">
                        <span class="fw-light align-content-center" style="width: 30px; height: 30px;">${aTag}</span>
                        <input class="form-control ms-1" placeholder="Nội dung câu trả lời ${aTag}" value="${a.stringContent}"/>
                        <button class="addAFile btn btn-sm border bg-white ms-2 flex-shrink-0 highlight-hover"><i class="fa-solid fa-images"></i> Thêm ảnh</button>
                        <button class="removeAnswer btn btn-sm border bg-white ms-2 flex-shrink-0 highlight-hover"><i class="fa-solid fa-trash text-danger"></i></button>
                    </div>
                    <div class="d-flex flex-row aFiles mb-2" style="margin-left: 30px;"></div>
                </div>
            `);
            a.mediaFileUrls.forEach(e => answer.find(`.aFiles`).append(getFileTag(getFileName(e), e)));
            answer.find(`input`).change(() => questions[qIndex].answers[aIndex].stringContent = answer.find(`input`).val());
            answer.find(`button.addAFile`).click(() => addMediaFile(`#${qIndex} .${aIndex} .aFiles`, 'image/*', qIndex, aIndex));
            answer.find(`button.removeAnswer`).click(() => {
                $(`#${qIndex} .answers`).empty();
                $(`#${qIndex} .answerKeySelect`).empty();
                questions[qIndex].answers.splice(aIndex, 1);
                questions[qIndex].answers.forEach((e, i) => {
                    e.key = i+1;
                    addAnswer(qIndex, i, e);
                });
            });
            $(`#${qIndex} .answers`).append(answer);
            const radio = $(`
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="${qIndex}_correctKey" value="${aIndex + 1}" ${aIndex + 1 == questions[qIndex].correctKey? 'checked':''}>
                    <label class="form-check-label">${aTag}</label>
                </div>
            `);
            $(`#${qIndex} .answerKeySelect`).append(radio);
        }

        function getFileTag(filename, fileurl) {
            const fileTag = $(`
                <span class="bg-white border px-2 py-1 d-flex flex-row align-items-center me-2 mb-2 highlight-hover">
                    <div class="me-1 file-name" data-url="${fileurl}">${filename}</div>
                    <i class="fa-solid fa-xmark opacity-hover"></i>
                </span>
            `);
            fileTag.find('i').click(function (e) {
                e.stopPropagation();
                fileTag.remove();
            });
            fileTag.click(() => previewMediaFile(fileurl));
            return fileTag;
        }

        function getFileName(path) {
            path = path.split('?')[0].split('#')[0];
            const parts = path.replace(/\\/g, '/').split('/');
            return parts.pop() || '';
        }

        function uploadAutoGenerateSourceFile(containerSelector, accept, questionIndex, answerIndex = -1) {
            if ($('#uploadedSourceFiles span').length == 1) {
                showMess("Chỉ được tải lên 1 file duy nhất", false);
                return;
            }
            addMediaFile(containerSelector, accept, questionIndex, answerIndex, true);
        }

        function addMediaFile(containerSelector, accept, questionIndex, answerIndex = -1, isAutoGenQuestionFile = false) {
            
            const input = document.createElement('input');
            input.setAttribute('type', 'file');
            input.hidden = true;
            input.setAttribute('accept', accept);
            input.onchange = e => {
                const files = input.files;
                for(let f of files) {
                    const fileReader = new FileReader();
                    fileReader.onload = () => {
                        const url = fileReader.result;
                        const fileTag = getFileTag(f.name, url);
                        $(containerSelector).append(fileTag);

                        if (answerIndex == -1) {
                            questions[questionIndex].mediaFileUrls.push(f.name);
                        } else {
                            questions[questionIndex].answers[answerIndex].mediaFileUrls.push(f.name);
                        }
                    }
                    fileReader.readAsDataURL(f);
                }
                input.remove();
                if (isAutoGenQuestionFile) autoGenQuestionSourceFile = files[0];
            }
            $('body').append(input);
            input.click();
        }

        function addTag(newTag) {
            if ($('#tags .name').filter((i, el) => $(el).text() === newTag).length > 0) {
                showMess('Tag đã tồn tại!', false);
                return;
            }
            const tagItem = $(`
                <span class="bg-white border px-2 py-1 d-flex flex-row align-items-center me-2 highlight-hover">
                    <div class="me-1 tag-name">${newTag}</div>
                    <i class="fa-solid fa-xmark opacity-hover"></i>
                </span>
            `);
            tagItem.find('i').click(() => tagItem.remove());
            $('#tags').append(tagItem);
        }

        function showAddTagDialog() {
            const dialog = $(`
                <div class="vh-100 vw-100 position-fixed top-0 start-0 bg-secondary bg-opacity-50" style="z-index: 100;">
                    <div class="position-absolute start-50 translate-middle-x bg-white text-dark p-2" style="margin-top: 100px;  width: 500px;">
                        <div class="d-flex flex-column align-items-center w-100">
                            <div class="btn-close position-absolute end-0 top-0 m-1 opacity-hover" onclick="$('#confirm-dialog').hide()"></div>
                            <input id="tag-input" type="text" class="form-control my-3 mt-4" placeholder="Nhập tag mới">
                            <button class="btn-confirm fw-light border text-white shadow-sm p-1 px-2 opacity-hover" style="background-color: var(--main-color); width: 100px;">
                                <i class="fa-solid fa-check me-1"></i>Xác nhận
                            </button>
                        </div>
                    </div>
                </div>
            `);
            dialog.find('.btn-close').click(() => dialog.remove());
            dialog.find('.btn-confirm').click(() => {
                const newTag = dialog.find('input').val();
                addTag(newTag);
                dialog.remove();
            });
            $('body').append(dialog);
        }

        function generateQuestions() {
            var formData = new FormData();
            var promptContext = $('#ai-create-dialog textarea').val();
            if (!promptContext) {
                showMess("Vui lòng điền yêu cầu của bạn đối với bộ câu hỏi!", false);
                return;
            }
            formData.append('promptContext', promptContext);
            if (autoGenQuestionSourceFile) 
                formData.append('fileData', autoGenQuestionSourceFile);
            showLoading();
            $.ajax({
                url: '/quizzes/generate-questions',
                method: "POST",
                xhrFields: { withCredentials: true },
                contentType: false,
                processData: false,
                data: formData,
                success: res => {
                    if (res.succeeded) {
                        questions = [];
                        $('#questions').empty();
                        res.data.forEach(e => {
                            addQuestion({
                                stringContent: e.stringContent,
                                mediaFileUrls: e.mediaFileUrls,
                                correctKey: e.correctKey,
                                order: e.order,
                                answers: e.answers,
                                explanation: '',
                                isRemoved: false
                            });
                        });
                    }
                    $('#ai-create-dialog').hide();
                    hideLoading();
                },
                error: error => {
                    if (error.status === 403) {
                        removeSessionData();
                        window.location.href = "/forbidden";
                    }
                    else if (error.status == 401) {
                        $('#login-dialog').show()

                    }
                    hideLoading();
                    showMess(error.responseJSON.message, false);
                    console.error(error);
                }
            });
        }
    </script>
}

