@using Zlearn.V2.Application.Quizzes.DTOs
@model QuizDetailDto

@{
    ViewData["Title"] = Model.Name;
    ViewBag.MetaDescription = $"Bộ câu hỏi trắc nghiệm {Model.Name} thuộc danh mục {Model.CategoryName}. Gồm {Model.QuestionCount} câu hỏi.";
    ViewBag.Keywords = $"{Model.Name}, {Model.CategoryName}, trắc nghiệm, đề thi, ôn tập";
    ViewBag.OgType = "article";
    Layout = "~/Views/Shared/_Layout.cshtml";
    
    // Set up breadcrumbs
    ViewBag.Breadcrumbs = new List<(string Text, string Url)>
    {
        ("Trang chủ", "/"),
        ("Danh mục đề trắc nghiệm", "/danh-muc-trac-nghiem"),
        (Model.CategoryName, $"/danh-muc-trac-nghiem/{Model.CategorySLug}"),
        (Model.Name, "")
    };
}

<div class="container my-4">
    <div class="row g-3">
        <!-- Main Content -->
        <div class="col-lg-8">
            <!-- Quiz Info Card -->
            <div class="card shadow-sm mb-3">
                <div class="card-body">
                    <h3 class="mb-3">@Model.Name</h3>
                    
                    <div class="d-flex flex-wrap gap-3 mb-3">
                        <div class="d-flex align-items-center">
                            <i class="fa-solid fa-folder text-warning me-2"></i>
                            <span class="fw-light">@Model.CategoryName</span>
                        </div>
                        <div class="d-flex align-items-center">
                            <i class="fa-solid fa-question-circle text-primary me-2"></i>
                            <span class="fw-light">@Model.QuestionCount câu hỏi</span>
                        </div>
                        <div class="d-flex align-items-center">
                            <i class="fa-solid fa-users text-success me-2"></i>
                            <span class="fw-light">@Model.AttemptCount lượt làm</span>
                        </div>
                        <div class="d-flex align-items-center">
                            <i class="fa-solid fa-download text-info me-2"></i>
                            <span class="fw-light">@Model.DownloadCount lượt tải</span>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex gap-2 flex-wrap">
                        <a href="/cau-hoi-trac-nghiem/@Model.Questions.First().Slug" class="btn btn-primary flex-fill">
                            <i class="fa-solid fa-play me-2"></i>Làm bài ngay
                        </a>
                        <button class="btn btn-outline-success flex-fill" onclick="createExam()">
                            <i class="fa-solid fa-clipboard-check me-2"></i>Tạo đề kiểm tra
                        </button>
                        <button class="btn btn-outline-info" onclick="downloadQuiz()">
                            <i class="fa-solid fa-download me-2"></i>Tải xuống
                        </button>
                        <button class="btn btn-outline-secondary" onclick="shareQuiz()">
                            <i class="fa-solid fa-share-nodes me-2"></i>Chia sẻ
                        </button>
                    </div>
                </div>
            </div>

            <!-- Questions List -->
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="mb-0">
                        <i class="fa-solid fa-list-ol text-primary me-2"></i>
                        Danh sách câu hỏi (@Model.QuestionCount câu)
                    </h5>
                </div>
                <div class="card-body">
                    <div class="list-group list-group-flush" id="questionList">
                        @foreach (var question in Model.Questions)
                        {
                            <a href="/cau-hoi-trac-nghiem/@question.Slug" 
                               class="list-group-item list-group-item-action d-flex align-items-start">
                                <span class="badge bg-primary rounded-pill me-3 mt-1">@question.Order</span>
                                <div class="flex-fill">
                                    <div class="fw-normal">@question.Content</div>
                                </div>
                                <i class="fa-solid fa-chevron-right text-muted align-self-center"></i>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            <!-- Suggested Quizzes -->
            <div class="card shadow-sm sticky-top" style="top: 20px;">
                <div class="card-header bg-white">
                    <h6 class="mb-0">
                        <i class="fa-solid fa-lightbulb text-warning me-2"></i>
                        Đề thi gợi ý
                    </h6>
                </div>
                <div class="card-body" id="suggestedQuizzes">
                    <div class="text-center py-3">
                        <div class="spinner-border spinner-border-sm text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script asp-append-version="true">
        $(document).ready(() => {
            loadSuggestedQuizzes();
        });

        function loadSuggestedQuizzes() {
            // Load suggested quizzes from same category or random
            const params = new URLSearchParams({
                categoryId: '@Model.CategorySLug',
                pageIndex: 1,
                pageSize: 5,
                excludeId: '@Model.Id'
            });
            
            getData('/quizzes?' + params.toString(), res => {
                const quizzes = res.data?.items || [];
                const container = $('#suggestedQuizzes');
                container.empty();
                
                if (quizzes.length === 0) {
                    container.append(`
                        <p class="text-muted text-center mb-0">Chưa có đề thi gợi ý</p>
                    `);
                    return;
                }
                
                quizzes.forEach(quiz => {
                    const quizItem = $(`
                        <a href="/de-trac-nghiem/${quiz.slug}" class="text-decoration-none text-dark d-block mb-3 hover-shadow">
                            <div class="border rounded p-2 highlight-hover">
                                <div class="fw-bold small mb-1">${quiz.name}</div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <small class="text-muted">
                                        <i class="fa-solid fa-question-circle me-1"></i>${quiz.questionCount} câu
                                    </small>
                                    <small class="text-muted">
                                        <i class="fa-solid fa-users me-1"></i>${quiz.attemptCount}
                                    </small>
                                </div>
                            </div>
                        </a>
                    `);
                    container.append(quizItem);
                });
            });
        }

        function createExam() {
            // Mock function for creating exam
            showConfirm('Tạo đề kiểm tra với bộ câu hỏi này?', () => {
                showMess('Chức năng đang phát triển. Bạn có thể làm bài trực tiếp bằng nút "Làm bài ngay"', false);
            });
        }

        function downloadQuiz() {
            // Mock function for downloading quiz
            showMess('Chức năng tải xuống đang được phát triển', false);
        }

        function shareQuiz() {
            // Mock function for sharing quiz
            const url = window.location.href;
            copyToClipboard(url, 'Đã sao chép link chia sẻ');
        }
    </script>
}

@section Styles {
    <style>
        .hover-shadow:hover {
            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        }
        
        .list-group-item:hover {
            background-color: #f8f9fa;
        }
        
        .badge {
            min-width: 35px;
        }
        
        .sticky-top {
            position: sticky;
            top: 20px;
            z-index: 1020;
        }
    </style>
}

@section StructuredData {
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "Quiz",
        "name": "@Model.Name",
        "description": "@ViewBag.MetaDescription",
        "numberOfQuestions": @Model.QuestionCount,
        "educationalLevel": "intermediate",
        "inLanguage": "vi",
        "about": {
            "@@type": "Thing",
            "name": "@Model.CategoryName"
        },
        "interactionStatistic": {
            "@@type": "InteractionCounter",
            "interactionType": "https://schema.org/TakeAction",
            "userInteractionCount": @Model.AttemptCount
        },
        "provider": {
            "@@type": "Organization",
            "name": "ZLearn",
            "url": "@Context.Request.Scheme://@Context.Request.Host"
        }
    }
    </script>
    
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "BreadcrumbList",
        "itemListElement": [
            {
                "@@type": "ListItem",
                "position": 1,
                "name": "Trang chủ",
                "item": "@Context.Request.Scheme://@Context.Request.Host/"
            },
            {
                "@@type": "ListItem",
                "position": 2,
                "name": "Đề trắc nghiệm",
                "item": "@Context.Request.Scheme://@Context.Request.Host/de-trac-nghiem"
            },
            {
                "@@type": "ListItem",
                "position": 3,
                "name": "@Model.CategoryName",
                "item": "@Context.Request.Scheme://@Context.Request.Host/de-trac-nghiem?categoryId=@Model.CategoryId"
            },
            {
                "@@type": "ListItem",
                "position": 4,
                "name": "@Model.Name"
            }
        ]
    }
    </script>
}
