@using ZLearn.Application.Common.Utils
@using ZLearn.Application.Exams.DTOs
@using ZLearn.Infras.External.SignalR
@model ExamContentDto
@{
    ViewBag.Title = Model.ExamName;
}

<div id="main-content" class="container-fluid px-4">
    <div class="row g-2">
        <div class="col-3">
            <div id="questionMap" class="p-3 position-sticky top-0">
                @foreach (var item in Model.Questions)
                {
                    <div class="qMapItem border text-center py-1 bg-white rounded-1 shadow-sm highlight-hover">@item.Order</div>
                }
            </div>
        </div>
        <div class="col-9">
            <div class="card card-body d-flex flex-row align-items-center shadow-sm py-2 position-sticky mx-3" style="top: 10px; z-index: 2;">
                <h5 class="mb-0">@Model.ExamName</h5>
                <div class="flex-fill"></div>
                <div id="shortcut-guide" class="me-3 text-secondary" style="font-size: 12px;"><i class="fa-regular fa-keyboard me-1"></i> Phím tắt: <b>[↑]/[↓]</b> chuyển câu, <b>[1/2/3/4...]</b> chọn đáp án</div>
                <div id="countdown" class="me-3 fs-6 fw-bold">-- giờ -- phút -- giây</div>
                <button class="opacity-hover btn border btn-sm text-white" onclick="submit()" style="background-color: var(--main-color);">Nộp bài</button>
            </div>

            <div class="card card-body mt-2 mb-5" style="min-height: 100vh;">
                <div class="d-flex">
                    @if (!string.IsNullOrEmpty(Model.ParticipantCode))
                    {
                        <div>[@Model.ParticipantCode] - </div>
                    }
                    <div class="mx-2">@Model.ParticipantName</div>
                    <div class="flex-fill"></div>
                    <div>@Model.StartTime.ToLocalTime().ToString("HH:mm") - @(Model.EndTime.HasValue? Model.EndTime.Value.ToLocalTime().ToString("HH:mm"): Html.Raw("<i class=\"fa-solid fa-infinity\"></i>"))</div>
                </div>
                <hr>

                @foreach(var item in Model.Questions)
                {
                    <div id="@item.Order" class="d-flex flex-column question-container" style="font-size: 18px;">
                        <p class="mb-2"><b>Câu @item.Order</b>: @item.StringContent</p>
                        @foreach (var url in item.ImageUrls)
                        {
                            <!-- Image -->
                            <img src="@url" alt="" class="shadow-sm object-fit-contain border align-self-center mb-2" width="400" height="200">
                        }
                        @foreach (var url in item.VideoUrls)
                        {
                            <!-- Video -->
                            <video controls class="shadow-sm object-fit-contain border align-self-center mb-2" width="400" height="200">
                                <source src="testvideo.mp4">
                            </video>
                        }
                        @foreach (var url in item.AudioUrls)
                        {
                            <!-- Audio -->
                            <audio controls class="mb-3 shadow-sm rounded-pill bg-white align-self-center mb-2">
                                <source src="testaudio.mp3" type="audio/mpeg">
                                Your browser does not support the audio element.
                            </audio>
                        }
                        @for (int i = 0; i < item.Answers.Count; i++)
                        {
                            <div class="form-check form-check-inline mb-2">
                                <input class="form-check-input" type="radio" name="@item.Order-ans" onclick="selectAnswer(@item.Order - 1, @item.Answers[i].Key, '@item.Id')">
                                <label class="form-check-label" for="inlineRadio1">
                                    @StringHelper.IndexToChar(i). @item.Answers[i].StringContent
                                    @foreach (var url in item.Answers[i].ImageUrls)
                                    {
                                        <!-- Image -->
                                        <img src="@url" width="400" height="200" class="my-2 align-self-center object-fit-contain border" />
                                    }
                                </label>
                            </div>
                        }
                    </div>
                }

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script asp-append-version="true">
        const exam_connection = new signalR.HubConnectionBuilder()
            .withUrl("@ExamHub.HUB_URL", { withCredentials: true })
            .withAutomaticReconnect()
            .build();
        const selectedAns = {};
        let timeLeftToEnd = @Model.RemainingTimeToEnd;
        let timestamp = '@(Model.EndTime.HasValue? Model.EndTime.Value.ToString("yyyy-MM-ddTHH:mm:ssZ"):"")';
        let countdown_sub_id = null;
        let activeOrder = 1;

        function setActiveQuestion(order, scroll = false) {
            if (order < 1 || order > @Model.Questions.Count) return;
            activeOrder = order;

            $('.active-question').removeClass('active-question');
            $('.qMapItem.active').removeClass('active');

            const activeDiv = $(`#${order}`);
            activeDiv.addClass('active-question');

            const mapItem = $('.qMapItem').eq(order - 1);
            mapItem.addClass('active');

            if (scroll) {
                activeDiv[0].scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        }

        $(document).ready(() => {
            setActiveQuestion(1);

            // Restore answers from sessionStorage (L1 Client Cache)
            const savedAnswers = sessionStorage.getItem("exam_answers_" + "@Model.Id");
            if (savedAnswers) {
                Object.assign(selectedAns, JSON.parse(savedAnswers));
                for (const [qId, key] of Object.entries(selectedAns)) {
                    const inputs = $(`input[onclick*="'${qId}'"]`);
                    inputs.each(function() {
                        const onclickAttr = $(this).attr('onclick');
                        if (onclickAttr) {
                            const match = onclickAttr.match(/selectAnswer\(\s*\d+\s*,\s*(\d+)\s*,\s*'/);
                            if (match && parseInt(match[1]) === parseInt(key)) {
                                $(this).prop('checked', true);
                                const nameAttr = $(this).attr('name');
                                if (nameAttr) {
                                    const order = parseInt(nameAttr.split('-')[0]);
                                    if (!isNaN(order)) {
                                        $('.qMapItem').eq(order - 1).addClass('selected');
                                    }
                                }
                            }
                        }
                    });
                }
            }

            $('.qMapItem').on('click', function() {
                const order = parseInt($(this).text().trim());
                setActiveQuestion(order);
                scrollTo(`#${order}`, 80);
            });

            // Cowndown
            if (timestamp) startCountdown();

            // Start tracking
            window.addEventListener("beforeunload", async () => {
                await exam_connection.stop();
            });
            
            exam_connection.onreconnecting(err => {
                showMess('Mất kết nối mạng. Đang tự động kết nối lại...', false);
            });
            exam_connection.onreconnected(connectionId => {
                showMess('Đã kết nối lại thành công!', true);
            });
            exam_connection.onclose(err => {
                showMess('Mất kết nối hoàn toàn! Vui lòng tải lại trang.', false);
                console.error('Disconnected:', err.toString());
            });

            exam_connection.on('RequireUpdateProgress', () => {
                exam_connection.invoke('AnswerSelected', Object.keys(selectedAns).length);
            });
            exam_connection.on('ExamStatusChange', (status) => {
                if (status == 'Ended') {
                    endExam();
                }
            });
            exam_connection.start();

            // Tự động nhận diện câu hỏi kích hoạt khi cuộn
            let scrollTimeout;
            $(window).on('scroll', function() {
                clearTimeout(scrollTimeout);
                scrollTimeout = setTimeout(() => {
                    const scrollPos = $(window).scrollTop() + ($(window).height() / 2);
                    let foundOrder = 1;
                    let minDistance = Infinity;

                    $('.question-container[id]').each(function() {
                        const id = $(this).attr('id');
                        const order = parseInt(id);
                        if (!isNaN(order)) {
                            const top = $(this).offset().top;
                            const height = $(this).height();
                            const center = top + (height / 2);
                            const dist = Math.abs(scrollPos - center);
                            if (dist < minDistance) {
                                minDistance = dist;
                                foundOrder = order;
                            }
                        }
                    });

                    activeOrder = foundOrder;
                    $('.active-question').removeClass('active-question');
                    $('.qMapItem.active').removeClass('active');
                    $(`#${activeOrder}`).addClass('active-question');
                    $('.qMapItem').eq(activeOrder - 1).addClass('active');
                }, 100);
            });

            // Lắng nghe sự kiện bàn phím
            $(document).on('keydown', function(e) {
                if ($(e.target).is('input, textarea, select')) return;

                const key = e.key;
                if (key === 'ArrowUp' || key === 'ArrowLeft') {
                    e.preventDefault();
                    if (activeOrder > 1) {
                        setActiveQuestion(activeOrder - 1, true);
                    }
                } else if (key === 'ArrowDown' || key === 'ArrowRight') {
                    e.preventDefault();
                    if (activeOrder < @Model.Questions.Count) {
                        setActiveQuestion(activeOrder + 1, true);
                    }
                } else if (/^[1-9]$/.test(key)) {
                    const ansIndex = parseInt(key) - 1;
                    const inputs = $(`input[name="${activeOrder}-ans"]`);
                    if (ansIndex >= 0 && ansIndex < inputs.length) {
                        inputs.eq(ansIndex).click();
                    }
                }
            });
        });

        function selectAnswer(qIndex, key, qId) {
            if (!(qId in selectedAns)) {
                exam_connection.invoke('AnswerSelected', Object.keys(selectedAns).length + 1);
            }
            selectedAns[qId] = key;
            $('.qMapItem').eq(qIndex).addClass('selected');
            // Save to sessionStorage
            sessionStorage.setItem("exam_answers_" + "@Model.Id", JSON.stringify(selectedAns));
        }

        function endExam() {
            const submitData = {
                examId: "@Model.Id",
                answers: Object.entries(selectedAns).map(([questionId, submitKey]) => ({
                    questionId,
                    submitKey
                }))
            }
            postJsonData('/exams/submit', submitData, () => {
                sessionStorage.removeItem("exam_answers_" + "@Model.Id");
                window.location.replace(`/bai-kiem-tra/result?alias=@Model.Alias`);
            });
        }

        function submit() {
            let confirmMsg = "Xác nhận nộp bài?";
            const selectedLength = Object.keys(selectedAns).length;
            if (selectedLength < @Model.Questions.Count) 
                confirmMsg = `Bạn còn ${@Model.Questions.Count - selectedLength} câu chưa chọn đáp án, xác nhận nộp bài?`;
            showConfirm(confirmMsg, () => endExam());
        }

        function startCountdown() {
            countdown_sub_id = setInterval(() => {
                const sec = getSecondsBetween(new Date(), timestamp);
                if (sec <= 0) {
                    $('#countdown').text(`Đã hết giờ`);
                    clearInterval(countdown_sub_id);
                    return;
                }
                const h = Math.floor(sec / 3600);
                const m = Math.floor((sec % 3600) / 60);
                const s = sec % 60;
                $('#countdown').text(`${h} giờ ${m} phút ${s} giây`);
            }, 1000);
        }
    </script>
}

@section Styles {
    <style>
        #questionMap {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(36px, 1fr));
            gap: 8px;
        }

        .qMapItem {
            font-size: 13px;
            height: 36px;
            align-content: center;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .qMapItem.selected {
            background-color: var(--main-color) !important;
            color: white;
        }

        .active-question {
            border-left: 4px solid var(--main-color) !important;
            padding-left: 15px !important;
            transition: all 0.2s ease-in-out;
        }

        .qMapItem.active {
            border: 2px solid var(--main-color) !important;
            transform: scale(1.1);
            font-weight: bold;
        }
    </style>
}
