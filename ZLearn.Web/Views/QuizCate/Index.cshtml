@using ZLearn.Application.Categories.DTOs
@model List<CateListItemDto>

@{
    ViewData["Title"] = "Danh mục đề trắc nghiệm";
    ViewBag.MetaDescription = "Danh sách các danh mục chủ đề đề thi trắc nghiệm trên ZLearn. Mỗi danh mục chứa nhiều đề thi khác nhau, giúp bạn ôn tập và nâng cao kiến thức một cách hiệu quả.";
}

<div class="container">

    <div class="d-flex mb-3">
        <a asp-action="Create" asp-controller="Quizzes" class="btn bg-white border rounded-0 me-2 shadow-sm highlight-hover"><i class="fa-solid fa-plus"></i> Tạo đề mới</a>
        <a asp-action="Create" asp-controller="Exams" class="btn bg-white border rounded-0 me-2 shadow-sm highlight-hover"><i class="fa-regular fa-calendar-plus"></i> Tạo bài kiểm tra mới</a>
    </div>

    <div class="row g-3">

        @foreach (var item in Model)
        {
            <div class="col-3">
                <a  asp-action="Detail" asp-route-categorySlug="@item.Slug" class="card card-body shadow-sm overflow-hidden highlight-hover bg-with-image" style="height: 200px; background-image: url(@item.ThumbnailUrl);">
                    <!-- Title -->
                    <div class="content position-absolute align-content-center bg-black text-light start-0 w-100 top-50 translate-middle-y p-3
                                        text-center" style="opacity: 0.7; transition: opacity 0.6s ease;">
                        <!-- Name -->
                        <div class="max-3-lines fw-bold name" style="font-size: 18px;">@item.Name</div>
                        <!-- Stat -->
                        <div class="d-flex justify-content-center" style="font-size: 12px;">
                            <div><i class="fa-solid fa-list me-1"></i>@item.QuizCount Đề</div>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
</div>