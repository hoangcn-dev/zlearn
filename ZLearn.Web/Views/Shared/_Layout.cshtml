@inject IConfiguration Configuration

@{
    var currentUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}{Context.Request.QueryString}";
    var canonicalUrl = ViewBag.CanonicalUrl ?? $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";
    var googleSignInUrl = $"{@Configuration.GetSection("APIConfigs")["BaseUrl"]}/auth/sign-in/google?returnUrl={Uri.EscapeDataString(currentUrl)}";
    var siteName = "ZLearn - Nền tảng học tập trực tuyến";
    var defaultImage = $"{Context.Request.Scheme}://{Context.Request.Host}/images/banner-light.png";
    var ogImage = ViewBag.OgImage ?? defaultImage;
    var ogType = ViewBag.OgType ?? "website";

    var isShowNavigation = ViewData.ContainsKey("IsShowNavigation")
        ? bool.Parse(ViewData["IsShowNavigation"]!.ToString()!)
        : true;

    var isShowTopBar = ViewData.ContainsKey("IsShowTopBar")
        ? bool.Parse(ViewData["IsShowTopBar"]!.ToString()!)
        : true;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Primary Meta Tags -->
    <title>@ViewData["Title"] - Zlearn</title>
    <meta name="title" content="@ViewData["Title"] - Zlearn" />
    <meta name="description" content="@ViewBag.MetaDescription" />
    <meta name="keywords" content="@(ViewBag.Keywords ?? "trắc nghiệm, đề thi, học tập trực tuyến, ôn thi, câu hỏi trắc nghiệm")" />
    <meta name="author" content="ZLearn Team" />
    <link rel="canonical" href="@canonicalUrl" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="@ogType" />
    <meta property="og:url" content="@currentUrl" />
    <meta property="og:title" content="@ViewData["Title"] - Zlearn" />
    <meta property="og:description" content="@ViewBag.MetaDescription" />
    <meta property="og:image" content="@ogImage" />
    <meta property="og:site_name" content="@siteName" />
    <meta property="og:locale" content="vi_VN" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content="@currentUrl" />
    <meta name="twitter:title" content="@ViewData["Title"] - Zlearn" />
    <meta name="twitter:description" content="@ViewBag.MetaDescription" />
    <meta name="twitter:image" content="@ogImage" />

    <!-- Mobile Meta Tags -->
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="theme-color" content="#1e88e5" />

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="~/logo.ico" asp-append-version="true"/>
    <link rel="apple-touch-icon" href="~/images/logo-light-blue.png" asp-append-version="true" />

    <!-- Preconnect to External Resources -->
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="dns-prefetch" href="//cdnjs.cloudflare.com" />
    <link rel="dns-prefetch" href="//cdn.jsdelivr.net" />

    <!-- Stylesheets -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-LN+7fdVzj6u52u30Kp6M/trliBMCMKTyK833zpbD+pXdCLuTusPj697FH4R/5mcr" crossorigin="anonymous">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    
    @await RenderSectionAsync("Styles", required: false)
    @await RenderSectionAsync("StructuredData", required: false)
</head>
<body>

    <!-- Topbar -->
    @if (isShowTopBar) {

        <header>
            <div class="w-100" style="background-color: var(--main-color)">
                <div class="container py-2">
                    <div class="d-flex align-items-center">
                        <!-- Banner -->
                        <a href="/"><img src="/images/banner-light.png" alt="" asp-append-version="true" height="50"></a>

                        <!-- Search -->
                        <div class="d-flex ms-5 flex-fill">
                            @* <div class="position-relative ms-3 w-75">
                                <input type="text" class="rounded-1 w-100 border-0 ps-3 py-1" style="padding-right: 30px;" placeholder="Tìm kiếm theo tên đề, tên danh mục, tags, ...">
                                <i title="Tìm kiếm" class="opacity-hover fa-solid fa-magnifying-glass position-absolute end-0 top-50 translate-middle-y me-2"></i>
                            </div> *@
                            <a href="/gioi-thieu" class="text-white">Giới thiệu</a>
                        </div>

                        <!-- Status -->
                        <i class="fa-solid fa-bell text-white opacity-hover" title="Thông báo"></i>
                        <div class="d-flex ms-3 align-items-center">
                            <!-- LogedIn -->
                            <div id="loggedInContainer" class="d-flex align-items-center">
                                <img id="avt" src="" alt="" width="36" height="36" class="rounded-pill object-fit-cover">
                                <div class="d-flex flex-column mx-2">
                                    <div id="userName" class="fw-light text-white text-nowrap overflow-hidden" style="max-width: 120px; overflow: hidden; text-overflow: ellipsis;"></div>
                                    <div id="roles" class="fw-bold" style="font-size: 11px; color: var(--secondary-color)"></div>
                                </div>
                                <div class="dropdown">
                                    <i class="fa-solid fa-chevron-down fs-6 text-white opacity-hover" data-bs-toggle="dropdown"></i>
                                    <div id="account-actions" class="dropdown-menu rounded-0">
                                        <a asp-controller="Users" asp-action="Profile" class="dropdown-item"><i class="fa-solid fa-user me-1"></i> Thông tin tài khoản</a>
                                        <hr class="dropdown-divider">
                                        <a asp-controller="Quizzes" asp-action="MyQuiz" class="dropdown-item"><i class="fa-solid fa-file-lines me-1"></i> Quản lý đề thi</a>
                                        <a asp-controller="Exams" asp-action="Index" class="dropdown-item"><i class="fa-solid fa-clock me-1"></i> Quản lý bài thi</a>
                                        <hr class="dropdown-divider">
                                        <a onclick="sign_out()" class="dropdown-item"><i class="fa-solid fa-arrow-right-from-bracket me-1"></i> Đăng xuất</a>
                                    </div>
                                </div>
                            </div>
                            <!-- Login -->
                            <div id="btnLogin" class="fw-bold opacity-hover" style="font-size: 16px; color: var(--secondary-color)" onclick="document.getElementById('login-dialog').hidden = false">Đăng nhập</div>
                            <div id="login-dialog" hidden class="vw-100 vh-100 bg-secondary position-fixed top-0 start-0 bg-opacity-50" style="z-index: 1;">
                                <div class="text-center position-absolute bg-white translate-middle-x start-50 top-0 rounded-1 p-4" style="width: 400px; margin-top: 100px; box-shadow: 0px 0px 10px #bcbcbc;">
                                    <button class="btn-close position-absolute end-0 top-0 m-1" onclick="document.getElementById('login-dialog').hidden = true"></button>
                                    <h3 class="text-center mb-1 fw-bold">ZLEARN</h3>
                                    <p class="fw-light">Vui lòng đăng nhập để tiếp tục</p>
                                    <img class="mb-4" src="/images/logo-light-blue.png" alt="" asp-append-version="true" width="100">
                                    <a href="@googleSignInUrl" class="btn btn-dark d-flex justify-content-center w-100 align-items-center border-0 opacity-hover" style="background-color: var(--main-color);">
                                        <div class="fw-light align-content-center">Đăng nhập với Google</div>
                                        <svg class="ms-1" xmlns="http://www.w3.org/2000/svg" x="0px" y="0px" width="30" height="30" viewBox="0 0 48 48"><path fill="#FFC107" d="M43.611,20.083H42V20H24v8h11.303c-1.649,4.657-6.08,8-11.303,8c-6.627,0-12-5.373-12-12c0-6.627,5.373-12,12-12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C12.955,4,4,12.955,4,24c0,11.045,8.955,20,20,20c11.045,0,20-8.955,20-20C44,22.659,43.862,21.35,43.611,20.083z"></path><path fill="#FF3D00" d="M6.306,14.691l6.571,4.819C14.655,15.108,18.961,12,24,12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C16.318,4,9.656,8.337,6.306,14.691z"></path><path fill="#4CAF50" d="M24,44c5.166,0,9.86-1.977,13.409-5.192l-6.19-5.238C29.211,35.091,26.715,36,24,36c-5.202,0-9.619-3.317-11.283-7.946l-6.522,5.025C9.505,39.556,16.227,44,24,44z"></path><path fill="#1976D2" d="M43.611,20.083H42V20H24v8h11.303c-0.792,2.237-2.231,4.166-4.087,5.571c0.001-0.001,0.002-0.001,0.003-0.002l6.19,5.238C36.971,39.205,44,34,44,24C44,22.659,43.862,21.35,43.611,20.083z"></path></svg>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </header>
    }

    <!-- Navigation -->
    @if (isShowNavigation)
    {
        <section id="navbar" class="bg-white">
            <div class="w-100 shadow-sm">
                <div class="container">
                    <div id="navigation-tab" class="d-flex justify-content-between fw-bold">
                        <div class="flex-fill mx-1 text-center nav-tab selected">Đề thi trắc nghiệm</div>
                        <div class="flex-fill mx-1 text-center nav-tab">Tài liệu</div>
                        <div class="flex-fill mx-1 text-center nav-tab">Cộng đồng</div>
                        <div class="flex-fill mx-1 text-center nav-tab">Tutorials</div>
                    </div>
                </div>
            </div>
        </section>
    }

    <!-- Breadcrumb -->
    @await Html.PartialAsync("_Breadcrumb")
    
    <!-- Main Content -->
    <section>
        <div class="my-3" style="min-height: 100vh;">
            @RenderBody()
        </div>
    </section>

    <!-- Bubble -->
    <span id="bubble" class="position-fixed end-0 bottom-0 shadow-sm border-2 border-white border opacity-hover text-center align-content-center rounded-pill m-4 shadow-lg"
          style="height: 50px; width: 50px; background-color: var(--main-color)" title="Cuộn về đầu trang">
        <i class="fas fa-chevron-up fs-4 text-white"></i>
    </span>

    <!-- Footer -->
    <section>
        <div class="w-100 text-white" style="background-color: var(--main-color);">
            <div class="container pt-5">
                <div class="row g-3">

                    <!-- Intro -->
                    <div class="col-4">
                        <a href="#"><img src="/images/banner-light.png" alt="" height="50"></a>
                        <p class="mt-2 fw-light">ZLearn là nền tảng học tập trực tuyến hàng đầu, cung cấp kho tàng tài nguyên phong phú giúp bạn chinh phục kiến thức trong mọi lĩnh vực. Từ các khóa học chuyên sâu, bài giảng video, đến tài liệu tham khảo và bài tập thực hành, ZLearn được thiết kế để hỗ trợ người học ở mọi cấp độ, từ cơ bản đến nâng cao. Với giao diện thân thiện, nội dung chất lượng cao được cập nhật liên tục, và cộng đồng học tập sôi động, ZLearn cam kết đồng hành cùng bạn trên hành trình khám phá tri thức và phát triển bản thân. Hãy tham gia ZLearn ngay hôm nay để mở ra cánh cửa đến với thế giới học tập không giới hạn!</p>
                        <div class="d-flex mt-4">
                            <i class="fa-brands fa-facebook me-2 opacity-hover" title="Facebook"></i>
                            <i class="fa-brands fa-instagram me-2 opacity-hover"></i>
                            <i class="fa-brands fa-twitter me-2 opacity-hover"></i>
                            <i class="fa-brands fa-youtube me-2 opacity-hover"></i>
                        </div>
                        <i class="fw-light mt-1">Lượt truy cập tháng này: <b id="monthly_access_count">-</b></i>
                    </div>

                    <!-- Products -->
                    <div class="col-4">
                        <h5 class="mb-3">Websites</h5>
                        <div class="d-flex flex-column">
                            <a href="" class="text-decoration-none text-light opacity-hover mb-2 fw-light">Giới thiệu</a>
                            <a href="" class="text-decoration-none text-light opacity-hover mb-2 fw-light">ZTools - Công cụ hỗ trợ chuyển đổi và tải xuống</a>
                            <a href="" class="text-decoration-none text-light opacity-hover mb-2 fw-light">ZBlog - Chia sẻ kiến thức và tin tức</a>
                        </div>
                    </div>

                    <!-- Contact -->
                    <div class="col-4">
                        <h5 class="mb-3">Tương tác</h5>
                        <div class="d-flex flex-column">
                            <div class="text-light fw-light mb-1">Đăng kí nhận thông báo qua email</div>
                            <input type="email" placeholder="Email của bạn" class="px-2 py-1 border-0 mb-2">
                            <button class="border-0 text-white py-1" style="background-color: var(--secondary-color);">Đăng kí</button>
                        </div>

                        <h5 class="mb-3 mt-4">Liên hệ</h5>
                        <div class="d-flex flex-column">
                            <a href="" class="text-decoration-none text-light opacity-hover mb-2 fw-light">
                                <i class="fa-solid fa-envelope me-2"></i>hoangcn.dev@gmail.com
                            </a>
                        </div>
                    </div>

                    <!-- Copyright -->
                    <div class="col-12">
                        <p class="text-center border-top pt-2">&copy; Copyright 2024, All Rights Reserved by HoangCN - Version 1.1 - Last updated on Nov 10, 2025</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Loading -->
    @await Html.PartialAsync("_Loader")

    <script asp-append-version="true" src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js" integrity="sha512-7SRCYIJtR6F8ocwW7UxW6wGKqbSyqREDbfCORCbGLatU0iugBLwyOXpzhkPyHIFdBO0K2VCu57fvP2Twgx1o2A==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js" integrity="sha512-v2CJ7UaYy4JwqLDIrZUI/4hqeoQieOmAZNXBeQyjo21dadnwR+8ZaIJVT8EE2iyI61OV8e6M8PP2/4hpQINQ/g==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js" integrity="sha384-ndDqU0Gzau9qJ1lfW4pNLlhNTkCfHzAVBReH9diLvGRem5+R9g2FzA8ZGN954O5Q" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    <script asp-append-version="true">
        // Load monthly access count
        $.ajax({
            url: '/api/system/access-stat',
            method: 'GET',
            xhrFields: { withCredentials: true },
            success: function(res) {
                if (res.succeeded && res.data) {
                    $('#monthly_access_count').text(res.data.totalInDay.toLocaleString('vi-VN'));
                }
            },
            error: function(xhr, status, error) {
                console.error('Failed to load access count:', error);
                $('#monthly_access_count').text('N/A');
            }
        });
    </script>

    <script asp-append-version="true">
        showLoading();

        // Set up AJAX requests to use the base URL from configuration
        const baseUrl = '@Configuration.GetSection("APIConfigs")["BaseUrl"]';
        $.ajaxSetup({
            beforeSend: function(xhr, settings) {
                settings.url = baseUrl + settings.url;
            }
        });

        $(document).ready(() => {
            // Handle google call back
            const urlParams = new URLSearchParams(window.location.search);
            $('#loggedInContainer').addClass('d-none');
            if (urlParams.has('google-login-success')) {
                const isSuccess = urlParams.get('google-login-success');
                if (isSuccess) {
                    saveSessionData();
                } else {
                    alert('Đăng nhập thất bại.');
                }
            } else if (!getSessionData()) {
                saveSessionData();
            }
            hideLoading();

            // Bubble
            $('#bubble').on('click', () => scrollTo('header'));
        });


        function sign_out() {
            showConfirm("Xác nhận đăng xuất?", () => removeSessionData());
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
