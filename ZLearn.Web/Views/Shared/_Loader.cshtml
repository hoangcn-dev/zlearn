<div id="loader-container" class="position-fixed start-50 top-0 translate-middle bg-white rounded-pill shadow-sm" style="margin-top: 100px; height: 36px; width: 36px; padding: 6px;">
    <div class="loader"></div>
</div>

<style>
    .loader {
        width: 24px;
        height: 24px;
        border: 3px solid #000;
        border-bottom-color: transparent;
        margin-bottom: 0px;
        border-radius: 50%;
        display: inline-block;
        box-sizing: border-box;
        animation: rotation 1s linear infinite;
    }

    @@keyframes rotation {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }
</style>