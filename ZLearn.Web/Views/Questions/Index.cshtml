@using Zlearn.V2.Application.Quizzes.DTOs
@model QuestionContentDto

@{
    ViewData["Title"] = $"{Model.QuizName}: {Model.StringContent}";
    ViewBag.MetaDescription = $"Câu hỏi trắc nghiệm số {Model.Order} trong đề thi {Model.QuizName}. Nội dung: {Model.StringContent}";
    ViewBag.Keywords = $"{Model.QuizName}, câu hỏi {Model.Order}, trắc nghiệm, đề thi";
    ViewBag.OgType = "article";
    
    // Set up breadcrumbs
    ViewBag.Breadcrumbs = new List<(string Text, string Url)>
    {
        ("Trang chủ", "/"),
        ("Danh mục đề trắc nghiệm", "/danh-muc-trac-nghiem"),
        (Model.QuizName, $"/de-trac-nghiem/{Model.QuizSlug}"),
        ($"Câu {Model.Order}", "")
    };
}

<div class="container">
    <div class="row g-3">
        <div class="col-12">
            <button onclick="window.history.back()" class="border bg-white shadow-sm p-1 px-2 highlight-hover"><i class="fa-solid fa-chevron-left"></i> Về danh sách</button>
        </div>

        <div class="col-3">
            <div class="card card-body shadow-sm bg-with-image" style="position: sticky; top: 20px; max-height: 70vh; overflow-y: auto;">
                <!-- Title -->
                <h6 id="quizName" class="border-bottom pb-3 mb-3"></h6>
                <div id="questionMap">
                </div>
            </div>
        </div>

        <div class="col-9">
            <!-- Content -->
            <p class="mb-0"><b id="order">Câu @Model.Order: </b><span id="stringContent" class="fw-light">@Model.StringContent</span></p>
            
            <!-- Tags -->
            @* <div class="d-flex mb-1 align-items-center" style="font-size: 12px;">
                <i class="fa-solid fa-tags me-1" style="color: rgb(249, 166, 0);"></i>
                <a class="tag text-dark opacity-hover me-1 text-decoration-underline">#alo20245</a>
                
            </div> *@

            <!-- Stat -->
            <div class="d-flex mb-1 align-items-center text-secondary" style="font-size: 10px;">
                <span id="attempt">@Model.AttemptCount Lượt làm</span>
                <span class="mx-1">|</span>
                <span id="questionTypeTag" style="padding: 2px 6px; border-radius: 4px; font-weight: 500; font-size: 10px; color: white; background-color: @(Model.IsMultipleChoice ? "#8a3ffc" : "var(--secondary-color)")">@(Model.IsMultipleChoice ? "Nhiều đáp án" : "1 đáp án")</span>
                <span class="mx-1">|</span>
                <span id="shortcutGuide"><i class="fa-regular fa-keyboard me-1"></i> Phím tắt: ...</span>
            </div>

            <!-- Media Display Toggle Button -->
            <div id="btnToggeMediaDisplay" class="fw-bold mb-2 opacity-hover" style="font-size: 13px; color: var(--secondary-color)">
                <i class="fa-solid fa-chevron-up"></i> Ẩn
            </div>
            <div id="media">
                <!-- Audio -->
                <div id="audio">
                    @foreach (var item in Model.AudioUrls)
                    {
                        <audio controls class="mb-3 shadow-sm rounded-5 bg-white">
                            <source src="@item" type="audio/mpeg">
                            Your browser does not support the audio element.
                        </audio>
                    }
                </div>
                <div id="image-video" class="row g-2 mb-2">
                    <!-- Image -->
                    @foreach (var item in Model.ImageUrls)
                    {
                        <div class="col-6">
                            <img src="@item" loading="lazy" alt="Hình ảnh câu hỏi @Model.Order - @Model.QuizName" class="shadow-sm w-100 media-size" onclick="previewMediaFile('@item')">
                        </div>
                    }
                    <!-- Video -->
                    @foreach (var item in Model.VideoUrls)
                    {
                        <div class="col-6">
                            <video controls class="shadow-sm w-100 media-size" onclick="previewMediaFile('@item')">
                                <source src="@item">
                            </video>
                        </div>
                    }
                </div>
            </div>

            <!-- Answer -->
            <div id="answer">
                @foreach (var item in Model.Answers)
                {
                    <div class="ans card card-body highlight-hover fw-light mb-2" data-key="@item.Key" data-label="@item.Label">
                        <div>@item.Label. @item.StringContent</div>
                        @if (item.ImageUrls.Count > 0)
                        {
                            <div class="row g-2 mt-2">
                                <!-- Image -->
                                @foreach (var url in item.ImageUrls)
                                {
                                    <div class="col-4">
                                        <img src="@url" loading="lazy" alt="Đáp án @item.Label - Câu hỏi @Model.Order" class="shadow-sm w-100 object-fit-contain" height="200">
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Result -->
            <div id="result"></div>

            <!-- Actions -->
            <div id="action" class="d-flex justify-content-center align-items-center mt-3">
                <a id="btnPrev" class="border bg-white shadow-sm p-1 px-2 highlight-hover me-2"><i class="fa-solid fa-chevron-left"></i> Câu trước</a>
                <div id="multiSubmitSection" style="display: @(Model.IsMultipleChoice ? "block" : "none");">
                    <button id="btnSubmitAnswers" class="btn text-white fw-bold p-1 px-3 me-2" style="background-color: var(--main-color); border-radius: 4px; box-shadow: 0px 2px 4px rgba(0, 0, 0, 0.1); font-size: 14px;">Xác nhận</button>
                </div>
                <button onclick="window.history.back()" class="border bg-white shadow-sm p-1 px-2 highlight-hover"><i class="fa-solid fa-share"></i> Kết thúc</button>
                <a id="btnNext" class="border bg-white shadow-sm p-1 px-2 highlight-hover ms-2">Câu tiếp theo <i class="fa-solid fa-chevron-right"></i></a>
            </div>
        </div>

    </div>
</div>

@section Scripts 
{
    <script asp-append-version="true">
        let params = new URLSearchParams(window.location.search);
        let quizId = "@Model.QuizId";
        let questionId = "@Model.Id";
        let currentOrder = @Model.Order;
        let questionMap = [];
        let isAnsSelected = false;
        let isMultipleChoice = @(Model.IsMultipleChoice ? "true" : "false");

        function updateQuestionTypeTag(isMulti) {
            const tag = $('#questionTypeTag');
            const guide = $('#shortcutGuide');
            if (isMulti) {
                tag.text('Nhiều đáp án')
                   .css('background-color', '#8a3ffc');
                $('#multiSubmitSection').show();
                guide.html('<i class="fa-regular fa-keyboard me-1"></i> Phím tắt: <b>[1/2/3/4...]</b> chọn/bỏ chọn | <b>[Enter]</b> xác nhận | <b>[←]/[→]</b> chuyển câu');
            } else {
                tag.text('1 đáp án')
                   .css('background-color', 'var(--secondary-color)');
                $('#multiSubmitSection').hide();
                guide.html('<i class="fa-regular fa-keyboard me-1"></i> Phím tắt: <b>[1/2/3/4...]</b> chọn đáp án | <b>[←]/[→]</b> chuyển câu');
            }
        }

        function checkAnswerSingle(selectedDiv) {
            isAnsSelected = true;
            $('.ans').removeClass('highlight-hover');
            const selectedKey = selectedDiv.data('key');

            getData(`/quizzes/questions/${questionId}/correct-key`, res => {
                const data = res.data || res;
                const correctKeys = data.correctKeys || [];
                const correctLabels = correctKeys.map(k => $(`.ans[data-key="${k}"]`).data('label')).sort().join(', ');
                const isCorrect = correctKeys.includes(selectedKey);

                const message = isCorrect ?
                    '<span class="fw-bold" style="color: var(--success-color);"><i class="fa-solid fa-check"></i> Bạn đã chọn đúng</span>' :
                    '<span class="fw-bold" style="color: var(--error-color);"><i class="fa-solid fa-xmark"></i> Bạn đã chọn sai</span>';

                correctKeys.forEach(k => {
                    $(`.ans[data-key="${k}"]`).css('border', 'var(--success-color) 2px solid');
                });
                if (!isCorrect) {
                    selectedDiv.css('border', 'var(--error-color) 2px solid');
                }

                $('#result').html(`
                    <div class="d-flex flex-column">
                        <!-- Key -->
                        ${message}
                        <span class="fw-light my-2"> Đáp án đúng: ${correctLabels}</span>
                        <!-- Explaination -->
                        <span class="fw-light my-2"><i class="fa-solid fa-lightbulb text-warning"></i> Giải thích</span>
                        <div class="card card-body fw-light mb-2 fst-italic">
                            ${data.explanation}
                        </div>
                    </div>
                `);
            });
        }

        function checkAnswerMultiple() {
            isAnsSelected = true;
            $('.ans').removeClass('highlight-hover');
            $('#multiSubmitSection').hide();

            const selectedKeys = [];
            $('.ans.selected-answer').each(function() {
                selectedKeys.push($(this).data('key'));
            });

            getData(`/quizzes/questions/${questionId}/correct-key`, res => {
                const data = res.data || res;
                const correctKeys = data.correctKeys || [];
                const correctLabels = correctKeys.map(k => $(`.ans[data-key="${k}"]`).data('label')).sort().join(', ');

                const isCorrect = selectedKeys.length === correctKeys.length && 
                                  selectedKeys.every(k => correctKeys.includes(k));

                const message = isCorrect ?
                    '<span class="fw-bold" style="color: var(--success-color);"><i class="fa-solid fa-check"></i> Bạn đã chọn đúng</span>' :
                    '<span class="fw-bold" style="color: var(--error-color);"><i class="fa-solid fa-xmark"></i> Bạn đã chọn sai</span>';

                correctKeys.forEach(k => {
                    $(`.ans[data-key="${k}"]`).css('border', 'var(--success-color) 2px solid');
                });
                selectedKeys.forEach(k => {
                    if (!correctKeys.includes(k)) {
                        $(`.ans[data-key="${k}"]`).css('border', 'var(--error-color) 2px solid');
                    }
                });

                $('#result').html(`
                    <div class="d-flex flex-column">
                        <!-- Key -->
                        ${message}
                        <span class="fw-light my-2"> Đáp án đúng: ${correctLabels}</span>
                        <!-- Explaination -->
                        <span class="fw-light my-2"><i class="fa-solid fa-lightbulb text-warning"></i> Giải thích</span>
                        <div class="card card-body fw-light mb-2 fst-italic">
                            ${data.explanation}
                        </div>
                    </div>
                `);
            });
        }

        $(document).ready(async () => {
            updateQuestionTypeTag(isMultipleChoice);

            // Lắng nghe sự kiện bàn phím
            $(document).on('keyup', function(e) {
                if ($(e.target).is('input, textarea, select')) return;

                const key = e.key;
                if (key === 'ArrowLeft') {
                    if ($('#btnPrev').is(':visible')) {
                        $('#btnPrev').click();
                    }
                } else if (key === 'ArrowRight') {
                    if ($('#btnNext').is(':visible')) {
                        $('#btnNext').click();
                    }
                } else if (key === 'Enter') {
                    if (isMultipleChoice && $('#btnSubmitAnswers').is(':visible') && !isAnsSelected) {
                        $('#btnSubmitAnswers').click();
                    }
                } else if (/^[1-9]$/.test(key)) {
                    if (isAnsSelected) return;
                    const index = parseInt(key) - 1;
                    const targetAns = $('.ans').eq(index);
                    if (targetAns.length > 0) {
                        targetAns.click();
                    }
                }
            });

            // Use event delegation for answer option click
            $(document).on('click', '.ans', function() {
                if (isAnsSelected) return;
                if (isMultipleChoice) {
                    $(this).toggleClass('selected-answer');
                } else {
                    $('.ans').removeClass('selected-answer');
                    $(this).addClass('selected-answer');
                    checkAnswerSingle($(this));
                }
            });

            $(document).on('click', '.ans img', function(e) {
                e.stopPropagation();
                previewMediaFile($(this).attr('src'));
            });

            $('#btnSubmitAnswers').on('click', function() {
                if (isAnsSelected) return;
                checkAnswerMultiple();
            });

            // Add media display toggle btn
            $('#btnToggeMediaDisplay').on('click', function() {
                if ($(this).text().trim() == 'Ẩn')
                {
                    $(this).html(`<i class="fa-solid fa-chevron-down"></i> Hiện`);
                    $('#media').hide();
                }
                else
                {
                    $(this).html(`<i class="fa-solid fa-chevron-up"></i> Ẩn`);
                    $('#media').show();
                }
            });

            // Get question map
            $('#btnPrev').hide();
            $('#btnNext').hide();
            await getData(`/quizzes/@Model.QuizId/detail`, res => {
                $('#quizName').text(res.data.name);
                $('#questionMap').empty();

                res.data.questions.forEach(q => {
                    const questionDiv = $(`<div data-order="${q.order}" data-url="${q.url}" class="q-index text-center text-decoration-none fw-light align-content-center highlight-hover border-1 border rounded-1" style="height: 36px;">${q.order}</div>`);
                    questionDiv.on('click', () => loadQuestionData(q.id));
                    if (q.order == @Model.Order) {
                        questionDiv.addClass('question-index-selected');
                    }
                    $('#questionMap').append(questionDiv);
                });
                if (currentOrder > 1) {
                    $('#btnPrev').show();
                    $('#btnPrev').on('click', () => loadQuestionData(res.data.questions[currentOrder-2].id));
                }
                if (currentOrder < res.data.questions.length) {
                    $('#btnNext').show();
                    $('#btnNext').on('click', () => loadQuestionData(res.data.questions[currentOrder].id));
                }
                questionMap = res.data.questions;
            });
        });

        function updateLastUrlSegment(newSegment) {
            const url = new URL(window.location.href);
            const segments = url.pathname.split('/');
            segments[segments.length - 1] = newSegment;
            url.pathname = segments.join('/');
            window.history.replaceState({}, '', url);
        }

        async function loadQuestionData(id) {
            await getData(`/quizzes/questions/${id}`, response => {
                const res = response.data;

                // Update status
                questionId = res.id;
                currentOrder = res.order;
                isAnsSelected = false;
                isMultipleChoice = res.isMultipleChoice;
                updateQuestionTypeTag(isMultipleChoice);

                // Update UI
                document.title = `Câu ${res.order}: ${res.stringContent}`;
                updateLastUrlSegment(res.slug);
                $('#attempt').text(`${res.attemptCount} Lượt làm`);
                $('#order').text(`Câu ${res.order}: `);
                $('#stringContent').text(res.stringContent);
                $('#audio').empty();
                res.audioUrls.forEach(url => {
                    $('#audio').append(`
                        <audio controls class="mb-3 shadow-sm rounded-5 bg-white">
                            <source src="${url}" type="audio/mpeg">
                            Your browser does not support the audio element.
                        </audio>
                    `);
                });
                $('#image-video').empty();
                res.imageUrls.forEach(url => {
                    $('#image-video').append(`
                        <div class="col-6">
                            <img src="${url}" alt="" class="shadow-sm w-100" onclick="previewMediaFile('${url}')">
                        </div>
                    `);
                });
                res.videoUrls.forEach(url => {
                    $('#image-video').append(`
                        <div class="col-6">
                            <video controls class="shadow-sm w-100" onclick="previewMediaFile('${url}')">
                                <source src="${url}">
                            </video>
                        </div>
                    `);
                });
                $('#answer').empty();
                res.answers.forEach(ans => {
                    const ansDiv = $(`
                        <div class="ans card card-body highlight-hover fw-light mb-2" data-key="${ans.key}" data-label="${ans.label}">
                            <div>${ans.label}. ${ans.stringContent}</div>
                        </div>
                    `);
                    if (ans.imageUrls.length > 0) {
                        const imageHtml = ans.imageUrls.map(imgUrl => `
                            <div class="col-4">
                                <img src="${imgUrl}" alt="" class="shadow-sm w-100">
                            </div>
                        `).join('');
                        ansDiv.append(`
                            <div class="row g-2 mt-2">
                                ${imageHtml}
                            </div>
                        `);
                    }
                    $('#answer').append(ansDiv);
                });

                $("#result").empty();
                $('#btnToggeMediaDisplay').html(`<i class="fa-solid fa-chevron-up"></i> Ẩn`);
                $('#media').show();

                $('#btnPrev').off('click').hide();
                $('#btnNext').off('click').hide();

                if (currentOrder > 1) {
                    $('#btnPrev').show();
                    $('#btnPrev').on('click', () => loadQuestionData(questionMap[currentOrder-2].id));
                }
                if (currentOrder < questionMap.length) {
                    $('#btnNext').show();
                    $('#btnNext').on('click', () => loadQuestionData(questionMap[currentOrder].id));
                }
                $('.q-index.question-index-selected').removeClass('question-index-selected');
                $('.q-index').eq(res.order-1).addClass('question-index-selected');
                scrollTo('header');
            });
        }
    </script>
}

@section Styles {
    <style>
        .media-size{
            height: 300px;
            background-color: white;
            object-fit: contain;
            box-shadow: 0px 0px 5px gray;
        }

        #questionMap {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(36px, 1fr));
            gap: 8px;
        }

        .q-index {
            cursor: pointer;
            transition: all 0.2s ease;
        }
    </style>
}