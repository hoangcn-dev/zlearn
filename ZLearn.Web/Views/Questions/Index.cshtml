@using ZLearn.Application.Quizzes.DTOs
@model QuestionContentDto

@{
    ViewData["Title"] = $"{Model.QuizName}: {Model.StringContent}";
    ViewBag.MetaDescription = $"Câu hỏi trắc nghiệm số {Model.Order} trong đề thi {Model.QuizName}. Nội dung: {Model.StringContent}";
}

<div class="container">
    <div class="row g-3">
        <div class="col-12">
            <button onclick="window.history.back()" class="border bg-white shadow-sm p-1 px-2 highlight-hover"><i class="fa-solid fa-chevron-left"></i> Về danh sách</button>
        </div>

        <div class="col-3">
            <div class="card card-body shadow-sm overflow-hidden bg-with-image">
                <!-- Title -->
                <h6 id="quizName" class="border-bottom pb-3 mb-3"></h6>
                <div id="questionMap" class="d-flex flex-wrap justify-content-start">
                </div>
            </div>
        </div>

        <div class="col-9">
            <!-- Content -->
            <p class="mb-0"><b id="order">Câu @Model.Order: </b><span id="stringContent" class="fw-light">@Model.StringContent</span></p>
            
            <!-- Tags -->
            @* <div class="d-flex mb-1 align-items-center" style="font-size: 12px;">
                <i class="fa-solid fa-tags me-1" style="color: rgb(249, 166, 0);"></i>
                <a class="tag text-dark opacity-hover me-1 text-decoration-underline">#alo20245</a>
                
            </div> *@

            <!-- Stat -->
            <div class="d-flex mb-1 align-items-center text-secondary" style="font-size: 10px;">
                <span id="attempt">@Model.AttemptCount Lượt làm</span>
            </div>

            <!-- Media Display Toggle Button -->
            <div id="btnToggeMediaDisplay" class="fw-bold mb-2 opacity-hover" style="font-size: 13px; color: var(--secondary-color)">
                <i class="fa-solid fa-chevron-up"></i> Ẩn
            </div>
            <div id="media">
                <!-- Audio -->
                <div id="audio">
                    @foreach (var item in Model.AudioUrls)
                    {
                        <audio controls class="mb-3 shadow-sm rounded-5 bg-white">
                            <source src="@item" type="audio/mpeg">
                            Your browser does not support the audio element.
                        </audio>
                    }
                </div>
                <div id="image-video" class="row g-2 mb-2">
                    <!-- Image -->
                    @foreach (var item in Model.ImageUrls)
                    {
                        <div class="col-6">
                            <img src="@item" alt="" class="shadow-sm w-100">
                        </div>
                    }
                    <!-- Video -->
                    @foreach (var item in Model.VideoUrls)
                    {
                        <div class="col-6">
                            <video controls class="shadow-sm w-100">
                                <source src="@item">
                            </video>
                        </div>
                    }
                </div>
            </div>

            <!-- Answer -->
            <div id="answer">
                @foreach (var item in Model.Answers)
                {
                    <div class="ans card card-body highlight-hover fw-light mb-2" data-key="@item.Key" data-label="@item.Label">
                        <div>@item.Label. @item.StringContent</div>
                        @if (item.ImageUrls.Count > 0)
                        {
                            <div class="row g-2 mt-2">
                                <!-- Image -->
                                @foreach (var url in item.ImageUrls)
                                {
                                    <div class="col-4">
                                        <img src="@url" alt="" class="shadow-sm w-100">
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Result -->
            <div id="result"></div>

            <!-- Actions -->
            <div id="action" class="d-flex justify-content-center mt-3">
                <a id="btnPrev" class="border bg-white shadow-sm p-1 px-2 highlight-hover me-2"><i class="fa-solid fa-chevron-left"></i> Câu trước</a>
                <button onclick="window.history.back()" class="border bg-white shadow-sm p-1 px-2 highlight-hover"><i class="fa-solid fa-share"></i> Kết thúc</button>
                <a id="btnNext" class="border bg-white shadow-sm p-1 px-2 highlight-hover ms-2">Câu tiếp theo <i class="fa-solid fa-chevron-right"></i></a>
            </div>
        </div>

    </div>
</div>

@section Scripts 
{
    <script asp-append-version="true">
        let params = new URLSearchParams(window.location.search);
        let qId = params.get('id');
        let currentOrder = @Model.Order;
        let questionMap = [];
        let isAnsSelected = false;

        $(document).ready(() => {
            // Add answer click lisnter
            $('.ans').on('click', function() {
                if (isAnsSelected) return;
                $(this).addClass('selected-answer')
                $('.ans').removeClass('highlight-hover')
                isAnsSelected = true;
                getData(`/quizzes/questions/${qId}/correct-key`, res => {
                    const correctDiv = $(`.ans[data-key="${res.correctKey}"]`)
                    const message = res.correctKey == $(this).data('key')?
                        '<span class="fw-bold" style="color: var(--success-color);"><i class="fa-solid fa-check"></i> Bạn đã chọn đúng</span>':
                        '<span class="fw-bold" style="color: var(--error-color);"><i class="fa-solid fa-xmark"></i> Bạn đã chọn sai</span>'

                    $('#result').append(`
                        <div class="d-flex flex-column">
                            <!-- Key -->
                            ${message}
                            <span class="fw-light my-2"> Đáp án đúng ${correctDiv.data("label")}</span>
                            <!-- Explaination -->
                            <span class="fw-light my-2"><i class="fa-solid fa-lightbulb text-warning"></i> Giải thích</span>
                            <div class="card card-body fw-light mb-2 fst-italic">
                                ${res.explanation}
                            </div>
                        </div>
                    `);

                    // scrollTo('#result')
                });
            });

            // Add media display toggle btn
            $('#btnToggeMediaDisplay').on('click', function() {
                if ($(this).text().trim() == 'Ẩn')
                {
                    $(this).html(`<i class="fa-solid fa-chevron-down"></i> Hiện`);
                    $('#media').hide();
                }
                else
                {
                    $(this).html(`<i class="fa-solid fa-chevron-up"></i> Ẩn`);
                    $('#media').show();
                }
            });

            // Get question map
            $('#btnPrev').hide();
            $('#btnNext').hide();
            getData(`/quizzes/@Model.QuizId/detail`, res => {
                $('#quizName').text(res.name);
                $('#questionMap').empty();
                res.questions.forEach(q => {
                    const questionDiv = $(`<div data-order="${q.order}" data-url="${q.url}" class="q-index text-center text-decoration-none fw-light align-content-center highlight-hover me-2 mb-2 border-1 border rounded-1" style="width: 32px; height: 32px;">${q.order}</div>`);
                    questionDiv.on('click', () => loadQuestionData(q.id));
                    if (q.order == @Model.Order) {
                        questionDiv.addClass('question-index-selected');
                    }
                    $('#questionMap').append(questionDiv);
                });
                if (currentOrder > 1) {
                    $('#btnPrev').show();
                    $('#btnPrev').on('click', () => loadQuestionData(res.questions[currentOrder-2].id));
                }
                if (currentOrder < res.questions.length) {
                    $('#btnNext').show();
                    $('#btnNext').on('click', () => loadQuestionData(res.questions[currentOrder].id));
                }
                questionMap = res.questions;
            });
        });

        function loadQuestionData(id) {
            getData(`/quizzes/questions/${id}`, res => {
                // Update status
                qId = res.id;
                currentOrder = res.order;
                isAnsSelected = false;

                // Update UI
                document.title = `Câu ${res.order}: ${res.stringContent}`;
                updateQueryParam("id", res.id);
                $('#attempt').text(`${res.attemptCount} Lượt làm`);
                $('#order').text(`Câu ${res.order}: `);
                $('#stringContent').text(res.stringContent);
                $('#audio').empty();
                res.audioUrls.forEach(url => {
                    $('#audio').append(`
                        <audio controls class="mb-3 shadow-sm rounded-5 bg-white">
                            <source src="${url}" type="audio/mpeg">
                            Your browser does not support the audio element.
                        </audio>
                    `);
                });
                $('#image-video').empty();
                res.imageUrls.forEach(url => {
                    $('#image-video').append(`
                        <div class="col-6">
                            <img src="${url}" alt="" class="shadow-sm w-100">
                        </div>
                    `);
                });
                res.videoUrls.forEach(url => {
                    $('#image-video').append(`
                        <div class="col-6">
                            <video controls class="shadow-sm w-100">
                                <source src="${url}">
                            </video>
                        </div>
                    `);
                });
                $('#answer').empty();
                res.answers.forEach(ans => {
                    const ansDiv = $(`
                        <div class="ans card card-body highlight-hover fw-light mb-2" data-key="${ans.key}" data-label="${ans.label}">
                            <div>${ans.label}. ${ans.stringContent}</div>
                        </div>
                    `);
                    if (ans.imageUrls.length > 0) {
                        const imageHtml = ans.imageUrls.map(imgUrl => `
                            <div class="col-4">
                                <img src="${imgUrl}" alt="" class="shadow-sm w-100">
                            </div>
                        `).join('');
                        ansDiv.append(`
                            <div class="row g-2 mt-2">
                                ${imageHtml}
                            </div>
                        `);
                    }
                    ansDiv.on('click', function() {
                        if (isAnsSelected) return;
                        $(this).addClass('selected-answer')
                        $('.ans').removeClass('highlight-hover')
                        isAnsSelected = true;
                        getData(`/quizzes/questions/${qId}/correct-key`, res => {
                            const correctDiv = $(`.ans[data-key="${res.correctKey}"]`)
                            const message = res.correctKey == $(this).data('key')?
                                '<span class="fw-bold" style="color: var(--success-color);"><i class="fa-solid fa-check"></i> Bạn đã chọn đúng</span>':
                                '<span class="fw-bold" style="color: var(--error-color);"><i class="fa-solid fa-xmark"></i> Bạn đã chọn sai</span>'

                            $('#result').append(`
                                <div class="d-flex flex-column">
                                    <!-- Key -->
                                    ${message}
                                    <span class="fw-light my-2"> Đáp án đúng ${correctDiv.data("label")}</span>
                                    <!-- Explaination -->
                                    <span class="fw-light my-2"><i class="fa-solid fa-lightbulb text-warning"></i> Giải thích</span>
                                    <div class="card card-body fw-light mb-2 fst-italic">
                                        ${res.explanation}
                                    </div>
                                </div>
                            `);

                            // scrollTo('#result')
                        });
                    });
                    $('#answer').append(ansDiv);
                });

                $("#result").empty();
                $('#btnToggeMediaDisplay').html(`<i class="fa-solid fa-chevron-up"></i> Ẩn`);
                $('#media').show();
                $('#btnPrev').hide();
                $('#btnNext').hide();
                if (currentOrder > 1) {
                    $('#btnPrev').show();
                    $('#btnPrev').on('click', () => loadQuestionData(questionMap[currentOrder-2].id));
                }
                if (currentOrder < questionMap.length) {
                    $('#btnNext').show();
                    $('#btnNext').on('click', () => loadQuestionData(questionMap[currentOrder].id));
                }
                $('.q-index.question-index-selected').removeClass('question-index-selected');
                $('.q-index').eq(res.order-1).addClass('question-index-selected');
                scrollTo('header');
            });
        }
    </script>
}
