{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "/logs/zlearn_log_",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level:u3}] {Message} [UserId:{UserId}] [Ip:{IpAddress}]{NewLine}{Exception}"
        }
      },
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level:u3}] {Message} [UserId:{UserId}] [Ip:{IpAddress}]{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "GoogleAuth": {
    "CallbackPath": "/api/google-login"
  },
  "APIConfigs": {
    "BaseUrl": "https://localhost:7284/api"
  },
  "Redis": {
    "EndPoints": {
      "Default": "localhost:6379"
    },
    "Ssl": false,
    "ConnectTimeout": 5000,
    "SyncTimeout": 5000,
    "ConnectRetry": 4
  },
  "JWT": {
    "ATExpirationMinutes": 60,
    "RTExpirationMinutes": 10080,
    "Issuer": "ZLEARN",
    "Audience": "ZLEARN"
  },
  "Backup": {
    "BackupDirectory": "backup",
    "RetentionPeriodDays": 2,
    "Enabled": true,
    "IntervalMinutes": 60,
    "FilePrefix": "zlearn_db_backup"
  },
  "AccessTrackingConfig": {
    "AutoSaveIntervalMinutes": 5,
    "TrackingPath": "access-tracking",
    "Enabled": true
  }
}
