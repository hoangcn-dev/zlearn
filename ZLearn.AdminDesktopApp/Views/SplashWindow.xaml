<Window x:Class="ZLearn.AdminDesktopApp.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZLearn.AdminDesktopApp.Views" 
        xmlns:viewmodels="clr-namespace:ZLearn.AdminDesktopApp.ViewModels" 
        d:DataContext="{d:DesignInstance Type=viewmodels:SplashViewModel}"
        mc:Ignorable="d"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#3498db"
        Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Image 
            Grid.Row="0" 
            Source="/Resources/logo.png" 
            Width="150" Height="150"
            Margin="0,30,0,0"/>

        <TextBlock Grid.Row="1" 
           Text="ZLearn Admin" 
           FontSize="28" 
           FontWeight="Bold" 
           Foreground="White" 
           HorizontalAlignment="Center" 
           Margin="0,20,0,10"/>

        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="{Binding LoadingMessage}"
               Foreground="White"
               FontSize="18"
               HorizontalAlignment="Center"/>
            <ProgressBar Width="300" 
                 Height="8" 
                 Margin="0,15,0,0"
                 IsIndeterminate="True"
                 Foreground="White"
                 Background="#2980b9"/>
        </StackPanel>

        <TextBlock Grid.Row="3" 
           Text="© 2023 ZLearn" 
           HorizontalAlignment="Center" 
           VerticalAlignment="Bottom" 
           Foreground="White" 
           Margin="0,0,0,15"/>
    </Grid>
</Window>
