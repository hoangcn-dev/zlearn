<UserControl x:Class="ZLearn.AdminDesktopApp.Features.SystemFeature.Views.SystemStatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZLearn.AdminDesktopApp.Features.SystemFeature.Views" xmlns:components="clr-namespace:ZLearn.AdminDesktopApp.Components" xmlns:viewmodels="clr-namespace:ZLearn.AdminDesktopApp.Features.SystemFeature.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:SystemStatViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border Background="LightGray" Padding="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <components:VerticalBox 
                    Title="Đang truy cập" Value="{Binding CurrentAccessCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource VerticalBoxStyle}"
                    Width="Auto"
                    Margin="0 0 5 5"
                    HorizontalAlignment="Left"/>
                
                <components:VerticalBox 
                    Title="Lượt truy cập trong ngày" Value="{Binding History.TotalInDay}"
                    Style="{StaticResource VerticalBoxStyle}"
                    Width="Auto"
                    Margin="0 0 5 5"
                    HorizontalAlignment="Left"/>

                <components:VerticalBox 
                    Title="Tổng lượt truy cập" Value="{Binding History.Total}"
                    Style="{StaticResource VerticalBoxStyle}"
                    Width="Auto"
                    Margin="0 0 5 5"
                    HorizontalAlignment="Left"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
