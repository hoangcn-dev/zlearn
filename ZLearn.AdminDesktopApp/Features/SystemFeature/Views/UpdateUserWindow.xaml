<Window x:Class="ZLearn.AdminDesktopApp.Features.SystemFeature.Views.UpdateUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZLearn.AdminDesktopApp.Features.SystemFeature.Views" xmlns:components="clr-namespace:ZLearn.AdminDesktopApp.Components" xmlns:views="clr-namespace:ZLearn.AdminDesktopApp.Views" xmlns:viewmodels="clr-namespace:ZLearn.AdminDesktopApp.Features.SystemFeature.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:UpdateUserViewModel}"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        FontSize="12"
        Title="Thông tin chi tiết người dùng" Height="600" Width="1200">
    <ScrollViewer Margin="20" VerticalScrollBarVisibility="Auto" Padding="0 0 5 0">
        <Border>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition MinHeight="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
            
                <!-- Header -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="ID:" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="UserName:" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Họ đệm:" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Tên:" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Bí danh:" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="5" Grid.Column="0" Text="Email:" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="6" Grid.Column="0" Text="Quyền:" FontWeight="Bold" VerticalAlignment="Top"/>
                <TextBlock Grid.Row="7" Grid.Column="0" Text="Số điện thoại:" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="8" Grid.Column="0" Text="Lần cuối đăng nhập:" FontWeight="Bold" VerticalAlignment="Center"/>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="Xác thực email:" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Kích hoạt TK:" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Grid.RowSpan="7" Text="Ảnh đại diện:" FontWeight="Bold" VerticalAlignment="Top"/>

                <!-- Value -->
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Data.Id}" VerticalAlignment="Center" Margin="0 0 10 0"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Data.UserName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" VerticalAlignment="Center" Padding="5" Margin="0 0 10 0"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Data.LastName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" VerticalAlignment="Center" Padding="5" Margin="0 0 10 0"/>
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Data.FirstName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" VerticalAlignment="Center" Padding="5" Margin="0 0 10 0"/>
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Data.NickName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" VerticalAlignment="Center" Padding="5" Margin="0 0 10 0"/>
                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Data.Email}" VerticalAlignment="Center" Margin="0 0 10 0"/>
                <ListBox BorderThickness="0" ItemsSource="{Binding Roles, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Row="6" Grid.Column="1">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0 5">
                                <CheckBox IsChecked="{Binding IsSelected}"/>
                                <TextBlock Text="{Binding Name}" Margin="5 0 0 0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding Data.PhoneNumber, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" VerticalAlignment="Center" Padding="5" Margin="0 0 10 0"/>
                <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding Data.LastLogin, StringFormat=\{0:dd/MM/yyyy HH:mm\}}" VerticalAlignment="Center" Margin="0 0 10 0"/>
                <components:LoadingButton
                    Grid.ColumnSpan="4"
                    Grid.Row="9"
                    Grid.Column="0"
                    Margin="10 30 10 0"
                    Width="200"
                    Style="{StaticResource LoadingButtonStyle}"
                    Command="{Binding UpdateCommand}"
                    IsLoading="{Binding IsLoading}"
                    Content="Lưu thay đổi"/>
            
                <CheckBox Grid.Row="0" Grid.Column="3" IsChecked="{Binding Data.EmailConfirmed, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" VerticalAlignment="Center"/>
                <CheckBox Grid.Row="1" Grid.Column="3" IsChecked="{Binding Data.IsActive, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="2" Grid.Column="3" Grid.RowSpan="7">
                    <Border BorderThickness="1" BorderBrush="Black">
                        <Image Source="{Binding ThumbnailUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="Auto" Height="260" VerticalAlignment="Center" Margin="5"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0 2">
                        <components:LoadingButton
                            Style="{StaticResource LoadingButtonStyle}"
                            Command="{Binding UploadThumbnailFileCommand}"
                            Content="Đổi ảnh" Width="100"/>
                        <views:SuccessTextBlock 
                            Message="{Binding UploadFileName}" 
                            Visibility="{Binding ShowFileUploadedMessage}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </ScrollViewer>
</Window>
