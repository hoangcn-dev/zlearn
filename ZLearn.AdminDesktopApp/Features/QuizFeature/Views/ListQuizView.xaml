<UserControl x:Class="ZLearn.AdminDesktopApp.Features.QuizFeature.Views.ListQuizView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZLearn.AdminDesktopApp.Features.QuizFeature.Views" xmlns:viewmodels="clr-namespace:ZLearn.AdminDesktopApp.Features.QuizFeature.ViewModels" xmlns:components="clr-namespace:ZLearn.AdminDesktopApp.Components" d:DataContext="{d:DesignInstance Type=viewmodels:ListQuizViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0 0 0 5">
            <Button Content="Tạo mới" Width="80" Style="{StaticResource Default}" Command="{Binding ShowAddQuizCommand}"/>
            <Button Content="Xóa" Visibility="{Binding ShowDeleteButton}" Width="80" Margin="5 0 0 0" Style="{StaticResource Default}" Command="{Binding DeleteCommand}"/>
            <Button Content="Xem chi tiết" Style="{StaticResource Default}" Width="80" Margin="5 0 0 0" Visibility="{Binding ShowDeleteButton}" />
            <Button Content="Cập nhật" Visibility="{Binding ShowUpdateButton}" Width="80" Margin="5 0 0 0" Style="{StaticResource Default}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0 0 0 5">
            <components:LoadingButton 
                Content="{Binding SearchButtonText}" Width="100" 
                Style="{StaticResource Default}" Margin="0 0 5 0"
                Command="{Binding SearchCommand}"
                IsLoading="{Binding IsLoading}"/>
            <TextBox 
                Width="200" Margin="0 0 5 0"
                IsEnabled="{Binding CanEditSearchText}"
                Padding="5" Text="{Binding Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <ComboBox Width="150" Margin="0 0 5 0"
                      SelectedItem="{Binding SelectedCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      ItemsSource="{Binding Categories}"
                      DisplayMemberPath="Name"
                      VerticalContentAlignment="Center"
                      Background="White"/>
            <Button 
                Command="{Binding ResetCommand}"
                Content="Reset" Style="{StaticResource Default}" Width="50"/>
        </StackPanel>

            <DataGrid
              Grid.Row="2" 
              AutoGenerateColumns="False" 
              IsReadOnly="True"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              CanUserReorderColumns="True"
              CanUserResizeColumns="True"
              CanUserSortColumns="True"
              SelectionUnit="Cell"
              AlternatingRowBackground="White"
              BorderThickness="1"
              ItemsSource="{Binding Quizzes}"
              BorderBrush="LightGray">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn 
                    Header="" 
                    Width="30"
                    ElementStyle="{StaticResource CenterCheckBox}"
                    Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                <DataGridTextColumn 
                    Header="STT" 
                    Width="Auto" 
                    Binding="{Binding Index}"
                    ElementStyle="{StaticResource CenterText}"/>
                <DataGridTextColumn Header="ID" 
                    Width="Auto" 
                    Binding="{Binding Data.Id}"/>
                <DataGridTextColumn Header="Danh mục" 
                    Width="Auto" 
                    Binding="{Binding Data.CategoryName}"/>
                <DataGridTextColumn Header="Tên đề" 
                    Width="*" 
                    Binding="{Binding Data.Name}"/>
                <DataGridTextColumn Header="Số lượt làm" 
                    Width="Auto"
                    Binding="{Binding Data.AttemptCount}"/>
                <DataGridTextColumn Header="Số lượng câu hỏi" 
                    Width="Auto" 
                    Binding="{Binding Data.QuestionCount}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
