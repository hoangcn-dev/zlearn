<Window x:Class="ZLearn.AdminDesktopApp.Features.QuizFeature.Views.AddQuizCateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZLearn.AdminDesktopApp.Features.QuizFeature.Views" 
        xmlns:viewmodels="clr-namespace:ZLearn.AdminDesktopApp.Features.QuizFeature.ViewModels" 
        xmlns:components="clr-namespace:ZLearn.AdminDesktopApp.Components" xmlns:views="clr-namespace:ZLearn.AdminDesktopApp.Views"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignData Type=viewmodels:AddQuizCateViewModel}"
        ResizeMode="NoResize"
        Title="Thêm danh mục mới" Height="220" Width="400">
    <StackPanel Margin="10">
        <TextBlock Text="Nhập tên danh mục mới"/>
        <TextBox Margin="0 10" Padding="5" Text="{Binding CategoryName, Mode=TwoWay}"/>

        <TextBlock Text="Tải ảnh bìa"/>
        <StackPanel Orientation="Horizontal" Margin="0 5 0 12">
            <components:LoadingButton
                Style="{StaticResource LoadingButtonStyle}"
                Command="{Binding UploadThumbnailFileCommand}"
                Content="Upload" Width="100"/>
            <views:SuccessTextBlock 
                Message="{Binding UploadFileName}" 
                Visibility="{Binding ShowFileUploadedMessage}" VerticalAlignment="Center"/>
        </StackPanel>

        <components:LoadingButton 
            Content="Tạo mới" 
            Style="{StaticResource LoadingButtonStyle}" 
            Width="120"
            Command="{Binding AddCateCommand}"
            IsLoading="{Binding IsLoading}"/>
    </StackPanel>
</Window>
