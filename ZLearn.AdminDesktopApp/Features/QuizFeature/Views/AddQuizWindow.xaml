<Window x:Class="ZLearn.AdminDesktopApp.Features.QuizFeature.Views.AddQuizWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZLearn.AdminDesktopApp.Features.QuizFeature.Views" 
        xmlns:viewmodels="clr-namespace:ZLearn.AdminDesktopApp.Features.QuizFeature.ViewModels" 
        xmlns:views="clr-namespace:ZLearn.AdminDesktopApp.Views" xmlns:components="clr-namespace:ZLearn.AdminDesktopApp.Components" xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks" xmlns:controls="clr-namespace:System.Windows.Controls;assembly=DotNetProjects.Input.Toolkit"
        d:DataContext="{d:DesignInstance Type=viewmodels:AddQuizViewModel}"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Background="LightGray"
        Title="Thêm đề mới" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Column="0" Grid.Row="0"
            Padding="10"
            Margin="5"
            Background="White">
            <StackPanel>
                <TextBlock Text="Tên đề mới"/>
                <TextBox Margin="0 5" Padding="5" Text="{Binding Name, Mode=TwoWay}"/>
                <TextBlock Text="Danh mục"/>
                <ComboBox 
                    Margin="0 5" Padding="5"
                    ItemsSource="{Binding Categories}"
                    DisplayMemberPath="Name"
                    SelectedItem="{Binding SelectedCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    IsEnabled="True"/>
                <TextBlock Text="Tags"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <controls:AutoCompleteBox 
                        Text="{Binding NewTag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Margin="0 5"
                        ItemsSource="{Binding DefaultTags}"
                        FilterMode="Contains"/>
                    <Button 
                        Margin="5 5 0 5"
                        Width="50"
                        Content="Thêm" Command="{Binding AddTagCommand}" Style="{StaticResource Default}" Grid.Column="1"/>
                </Grid>
                <ListBox Height="150" BorderThickness="0" ItemsSource="{Binding Tags, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock Text="{Binding}" VerticalAlignment="Stretch"/>
                                <Button Margin="10 0" Command="{Binding DataContext.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent" BorderThickness="0">
                                    <iconPacks:PackIconFontAwesome 
                                        DockPanel.Dock="Right"
                                        Kind="XmarkSolid"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Right"
                                        Width="10"
                                        Height="10"
                                        Foreground="Black"/>
                                </Button>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Grid.Row="0"
            Padding="10"
            Margin="0 5 5 5"
            Background="White">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0 0 5 0">
                <StackPanel>
                    <TextBlock Text="Tải file .json chứa data câu hỏi"/>

                    <StackPanel Orientation="Horizontal" Margin="0 5">
                        <components:LoadingButton
                            Style="{StaticResource LoadingButtonStyle}"
                            Command="{Binding UploadQuestionDataFileCommand}"
                            Content="Upload" Width="100"/>
                        <views:SuccessTextBlock 
                            Message="{Binding UploadFileName}" 
                            Visibility="{Binding ShowFileUploadedMessage}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="Tệp cần tải lên:" Margin="0 5 0 0"/>
                    <Button Content="Upload" Command="{Binding UploadMediaFileCommand}" Style="{StaticResource Default}" Width="100" HorizontalAlignment="Right"/>
                    <ListView ItemsSource="{Binding UploadFiles}" Margin="0 5 0 0" Focusable="False">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0 5">
                                    <TextBlock Text="{Binding FileName}" Width="200" VerticalAlignment="Center"/>
                                    <views:SuccessTextBlock Message="Đã tải" Visibility="{Binding IsUploaded, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <views:SuccessTextBlock Message="Đã lưu" Visibility="{Binding IsSaved, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" Margin="5 0 5 5">
            <components:LoadingButton 
                Command="{Binding SaveQuizCommand}"
                IsLoading="{Binding IsLoading}"
                Style="{StaticResource LoadingButtonStyle}"
                Content="Lưu" Width="100"/>
        </StackPanel>
    </Grid>
</Window>
