<Window x:Class="ZLearn.AdminDesktopApp.MainWindow"  
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"  
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"  
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"  
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"  
        xmlns:local="clr-namespace:ZLearn.AdminDesktopApp"  
        mc:Ignorable="d"  
        Background="LightGray"  
        Title="ZLearn Admin" Height="600" Width="1000"  
        xmlns:viewmodels="clr-namespace:ZLearn.AdminDesktopApp.ViewModels"
        d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
        xmlns:views="clr-namespace:ZLearn.AdminDesktopApp.Views" 
        xmlns:com="clr-namespace:ZLearn.AdminDesktopApp.Components" 
        xmlns:quizviews="clr-namespace:ZLearn.AdminDesktopApp.Features.QuizFeature.Views" 
        xmlns:quizviewmodels="clr-namespace:ZLearn.AdminDesktopApp.Features.QuizFeature.ViewModels" 
        xmlns:systemviews="clr-namespace:ZLearn.AdminDesktopApp.Features.SystemFeature.Views" 
        xmlns:systemviewmodels="clr-namespace:ZLearn.AdminDesktopApp.Features.SystemFeature.ViewModels" 
        xmlns:enums="clr-namespace:ZLearn.AdminDesktopApp.Enums"
        xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.FontAwesome"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type quizviewmodels:QuizCateViewModel}">
            <quizviews:QuizCateView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type quizviewmodels:QuizStatViewModel}">
            <quizviews:QuizStatView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type quizviewmodels:ListQuizViewModel}">
            <quizviews:ListQuizView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type systemviewmodels:ListLogsViewModel}">
            <systemviews:ListLogsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type systemviewmodels:ListUsersViewModel}">
            <systemviews:ListUsersView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type systemviewmodels:SystemStatViewModel}">
            <systemviews:SystemStatView/>
        </DataTemplate>

        <!-- NavButtonStyle -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" BorderThickness="0 1 0 0" BorderBrush="#FFB2B2B2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                </Grid.ColumnDefinitions>

                                <ContentPresenter Grid.Column="0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center"
                                          Content="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>


                                <ContentPresenter Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Content="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"/>

                                <iconPacks:PackIconFontAwesome Kind="AngleDownSolid"
                                                       x:Name="dropIcon"
                                                       Grid.Column="2"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       Width="10"
                                                       Foreground="Gray"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Cursor" Value="Hand"/>
                                <Setter TargetName="Border" Property="Background" Value="LightGray"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="LightCyan"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- NavButtonItemStyle -->
        <Style x:Key="NavButtonItemStyle"  TargetType="com:NavigationButton">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="30 0 0 0" />
            <Setter Property="Height" Value="30" />
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="LightGray"/>
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <!--Hiệu ứng hover-->
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True"/>
                        <Condition Property="IsSelected" Value="False"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#FFE5E5E5"/>
                </MultiTrigger>
                <!--Hiệu ứng selected-->
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFE5E5E5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Grid>  
        <Grid.RowDefinitions>  
            <RowDefinition Height="*"/>  
            <RowDefinition Height="Auto"/>  
        </Grid.RowDefinitions>  

        <Grid Grid.Row="0">  
            <Grid.ColumnDefinitions>  
                <ColumnDefinition Width="200"/>  
                <ColumnDefinition/>  
            </Grid.ColumnDefinitions>
            
            <!--Navigation Bar-->
            <Border Margin="5" Grid.Column="0" Background="White">
                <StackPanel>
                    <!-- Header -->
                    <TextBlock Text="Chức năng" 
                       VerticalAlignment="Center" 
                       FontWeight="SemiBold" 
                       Foreground="Gray"
                       Padding="5 3"/>

                    <!-- System -->
                    <Button Style="{StaticResource NavButtonStyle}" 
                        Content="Hệ thống"
                        x:Name="btnSystem"
                        Click="OnMenuButtonClick">  
                        <Button.Tag>
                            <iconPacks:PackIconFontAwesome Kind="ServerSolid" />
                        </Button.Tag>
                    </Button>
                    <StackPanel x:Name="spSystem" Visibility="Collapsed" Orientation="Vertical">
                        <com:NavigationButton 
                            Content="Thống kê"
                            Click="OnNavigate"
                            NavDestination="SystemAnal"
                            Style="{StaticResource NavButtonItemStyle}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="{x:Static enums:NavDestination.SystemAnal}"/>
                        <com:NavigationButton 
                            Content="Người dùng"
                            Click="OnNavigate"
                            NavDestination="SystemUser"
                            Style="{StaticResource NavButtonItemStyle}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="{x:Static enums:NavDestination.SystemUser}"/>
                        <com:NavigationButton 
                            Content="Logging"
                            Click="OnNavigate"
                            NavDestination="SystemLog"
                            Style="{StaticResource NavButtonItemStyle}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="{x:Static enums:NavDestination.SystemLog}"/>
                    </StackPanel>

                    <!-- Quiz test -->
                    <Button Style="{StaticResource NavButtonStyle}" 
                            Content="Trắc nghiệm"
                            x:Name="btnQuizTest"
                            Click="OnMenuButtonClick">
                        <Button.Tag>
                            <iconPacks:PackIconFontAwesome Kind="LayerGroupSolid" />
                        </Button.Tag>
                    </Button>
                    <StackPanel x:Name="spQuizTestItem" Visibility="Collapsed" Orientation="Vertical">
                        <com:NavigationButton 
                            Content="Thống kê"
                            NavDestination="QuizAnal"
                            Style="{StaticResource NavButtonItemStyle}"
                            Command="{Binding NavigateCommand}"
                            Click="OnNavigate"
                            CommandParameter="{x:Static enums:NavDestination.QuizAnal}"/>
                        <com:NavigationButton 
                            Content="Danh mục"
                            NavDestination="QuizCate"
                            Style="{StaticResource NavButtonItemStyle}"
                            Command="{Binding NavigateCommand}"
                            Click="OnNavigate"
                            CommandParameter="{x:Static enums:NavDestination.QuizCate}"/>
                        <com:NavigationButton 
                            Content="QL Đề"
                            NavDestination="QuizManage"
                            Style="{StaticResource NavButtonItemStyle}"
                            Command="{Binding NavigateCommand}"
                            Click="OnNavigate"
                            CommandParameter="{x:Static enums:NavDestination.QuizManage}"/>
                    </StackPanel>

                </StackPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Border Margin="0 5 5 5" Background="White" Padding="5 0 5 0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Quản lý danh mục đề"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock FontSize="10" Text="{Binding Role}" Margin="5 0 5 0" Background="Black" Foreground="White" Padding="5 2"/>
                            <TextBlock Text="{Binding UserName}" Margin="5 0 10 0" Foreground="Gray"/>
                            <iconPacks:PackIconFontAwesome Kind="ArrowRightFromBracketSolid" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Margin="0 0 5 5" Grid.Row="1">
                    <ContentControl  Content="{Binding CurrentViewModel}" />
                </Border>
            </Grid>

        </Grid>  

        <StatusBar Grid.Row="1">  
            <ProgressBar IsIndeterminate="True" Width="100" Height="15" Visibility="{Binding IsBusy}"/>  
            <TextBlock Text="{Binding Status}" Foreground="#FF545454"/>  
        </StatusBar>  
    </Grid>  
</Window>
